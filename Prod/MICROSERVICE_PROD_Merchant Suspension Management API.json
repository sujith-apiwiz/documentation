          },
          {
            "$ref": "#/components/parameters/merchantId"
          }
        ],
        "requestBody": {
          "description": "Suspends the specified merchant account temporarily. The request body must contain the necessary details to process the suspension.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuspendMerchantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The merchant has been suspended successfully.",
            "headers": {
              "X-Endpoint-Id": {
                "$ref": "#/components/headers/X-Endpoint-Id"
