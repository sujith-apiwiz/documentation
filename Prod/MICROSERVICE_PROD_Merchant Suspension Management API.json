  "paths": {
    "/v5/p2m/merchants/{merchantId}/suspend": {
      "post": {
        "tags": [
          "Merchant Management"
        ],
        "summary": "Suspend a specific merchant.",
        "description": "This endpoint allows you to suspend a merchant identified by their unique ID. Once suspended, the merchant will not be able to perform transactions until they are reactivated. This is useful for managing merchants that are in breach of terms or under review.",
        "operationId": "suspendMerchant",
        "parameters": [
          {
            "$ref": "#/components/parameters/x-workflow-id"
          },
          {
            "$ref": "#/components/parameters/idempotency-key"
          },
