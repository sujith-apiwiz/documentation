  "info": {
    "title": "MICROSERVICE_PROD_Merchant Suspension Management API",
    "description": "The Merchant Suspension Management API allows businesses to suspend merchant accounts on demand. This functionality is essential for managing compliance and risk by temporarily halting merchant activities due to various reasons such as policy violations or suspected fraud. Typical consumers of this API include compliance officers and fraud prevention teams who need to enforce account status changes swiftly. By utilizing this endpoint, organizations can maintain a responsible merchant ecosystem while ensuring rapid response to potential issues.",
    "version": "1.0"
  },
