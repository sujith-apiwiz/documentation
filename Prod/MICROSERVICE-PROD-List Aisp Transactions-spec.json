      "get": {
        "tags": [
          "AISP Transactions"
        ],
        "summary": "Retrieve a list of transactions.",
        "description": "This endpoint allows you to fetch a list of transactions associated with the AISP (Account Information Service Provider). You can use this to monitor account activity, review previous transactions, or fetch transaction details within a specified range.",
        "operationId": "listAispTransactions",
        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to retrieve transaction information from the AISP (Account Information Service Provider). It should include necessary parameters for transaction retrieval as defined in the schema.",
