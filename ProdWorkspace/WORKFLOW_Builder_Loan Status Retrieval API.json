      "GetLoanStatusByIdResponse_200": {
        "title": "Loan Status Response",
        "type": "object",
        "properties": {
          "data": {
            "description": "Contains loan details including its current status and financial information.",
            "$ref": "#/components/schemas/LoanDetails"
          }
        },
        "description": "Response schema for loan status retrieval. It contains the details of the loan associated with a specific ID.",
        "example": {
          "data": {
            "id": "LOAN-10004",
            "status": "ACTIVE",
            "loanType": "PERSONAL",
            "customerId": "CUST-50021",
            "principalAmount": 25000.0,
            "currency": "USD",
            "interestRate": 7.5,
            "termMonths": 36,
            "startDate": "2026-08-01",
            "maturityDate": "2029-08-01",
            "outstandingAmount": 24580.5
          }
        }
      },
      "LoanDetails": {
        "title": "Loan Details",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the loan.",
            "example": "123456"
          },
          "status": {
            "type": "string",
            "description": "Current status of the loan (e.g., active, paid, defaulted).",
            "example": "active"
          },
          "loanType": {
            "type": "string",
            "description": "Type of loan (e.g., personal, mortgage, auto).",
            "example": "personal"
          },
          "customerId": {
            "type": "string",
            "description": "Unique identifier for the customer associated with the loan.",
            "example": "cust789"
          },
          "principalAmount": {
            "type": "number",
            "description": "The original amount of money borrowed before interest.",
            "example": 10000.0
          },
          "currency": {
            "type": "string",
            "description": "Currency in which the loan amount is denominated.",
            "example": "USD"
          },
          "interestRate": {
            "type": "number",
            "description": "The annual interest rate applied to the loan, expressed as a percentage.",
            "example": 5.0
          },
          "termMonths": {
            "type": "integer",
            "description": "The term of the loan in months.",
            "format": "int32",
            "example": 24
          },
          "startDate": {
            "type": "string",
            "description": "The date when the loan was initiated.",
            "example": "2021-01-01"
          },
          "maturityDate": {
            "type": "string",
            "description": "The date when the loan is scheduled to be fully paid off.",
            "example": "2023-01-01"
          },
          "outstandingAmount": {
            "type": "number",
            "description": "The total amount of money still owed on the loan.",
            "example": 5000.0
          }
        },
        "description": "Detailed information about a specific loan."
      }
    },
