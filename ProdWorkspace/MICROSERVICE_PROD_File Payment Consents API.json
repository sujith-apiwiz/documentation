        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to create a new file payment consent for a payment initiation service provider (PISP). It includes all necessary details required for the consent, ensuring that the transaction is secure and authorized.",
