              "example": "Consumer"
            }
          },
          "FeeFreeLength": {
            "type": "integer",
            "description": "Length of the fee-free period (in months).",
            "format": "int32",
            "example": 12
          },
          "FeeFreeLengthPeriod": {
            "type": "string",
            "description": "Period unit for fee-free length.",
            "example": "months"
