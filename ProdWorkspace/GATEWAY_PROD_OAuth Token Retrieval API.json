            "description": "The timestamp indicating when the access token was issued.",
            "example": "1787807364279"
          },
          "token_type": {
            "type": "string",
            "description": "The type of the token returned (e.g., Bearer).",
            "example": "BearerToken"
          },
          "access_token": {
            "type": "string",
            "description": "The access token issued for authorization.",
            "example": "FBpOAKiLBhaBHIfPRa3sdVwuE6CF"
          },
          "status": {
            "type": "string",
            "description": "The current status of the token (e.g., valid, expired).",
            "example": "approved"
          },
          "expires_in": {
            "type": "string",
            "description": "The duration in seconds for which the access token is valid.",
            "example": "3599"
          }
        },
        "description": "Schema representing the response structure for the OAuth token retrieval.",
        "example": {
          "issued_at": "1787807364279",
          "token_type": "BearerToken",
          "access_token": "FBpOAKiLBhaBHIfPRa3sdVwuE6CF",
          "status": "approved",
          "expires_in": "3599"
        }
