        "summary": "Create a domestic standing order consent.",
        "description": "This operation allows the user to create a new consent for a domestic standing order. A domestic standing order enables regular payments to be made from one bank account to another on a defined schedule.",
        "operationId": "createDomesticStandingOrderConsent",
        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
