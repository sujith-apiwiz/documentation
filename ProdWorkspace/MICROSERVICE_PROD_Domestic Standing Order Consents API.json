  "openapi": "3.0.1",
  "info": {
    "title": "MICROSERVICE_PROD_Domestic Standing Order Consents API",
    "description": "The Domestic Standing Order Consents API facilitates the creation of consents for initiating domestic standing orders within the Open Banking framework. This API allows authorized third-party providers to generate consent agreements on behalf of customers, ensuring compliance with legal and regulatory standards. Typical consumers include financial institutions, payment service providers, and developers constructing apps that harness standing order functionalities for their clients. By using this API, businesses can enhance their payment processing capabilities and streamline authorization workflows.",
    "version": "1.0"
  },
