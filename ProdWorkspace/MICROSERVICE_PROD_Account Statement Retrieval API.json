  "info": {
    "title": "MICROSERVICE_PROD_Account Statement Retrieval API",
    "description": "The Account Statement Retrieval API enables clients to access detailed statements for specific accounts. Users can retrieve financial transaction histories by specifying the account and statement IDs, making it a vital tool for consumers needing insight into their account activity. This API is typically used by financial applications, banking systems, and advisory services to facilitate compliance and provide transparency to account holders. By offering seamless access to statement data, it enhances user engagement and supports informed financial decisions.",
    "version": "1.0"
  },
