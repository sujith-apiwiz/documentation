      "get": {
        "tags": [
          "Account Statements"
        ],
        "summary": "Retrieve a specific statement for an account.",
        "description": "This API endpoint allows users to retrieve a detailed statement for a specific account identified by its account ID (ACC-200045) and statement ID (RES-100045). Ideal for accessing financial transaction records associated with the account.",
        "operationId": "getAispAccountStatementById",
        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "The request body for retrieving account statements for the specified account and statement identifiers. This body should conform to the defined schema for the operation to ensure correct data retrieval.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAispAccountStatementByIdRequest"
              }
            }
          }
        },
        "responses": {
