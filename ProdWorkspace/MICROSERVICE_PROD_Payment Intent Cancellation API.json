        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Cancels a payment intent with the specified ID. This operation may be used to reverse the intent before it is processed or final. Ensure that the payment intent is in a state that allows cancellation.",
