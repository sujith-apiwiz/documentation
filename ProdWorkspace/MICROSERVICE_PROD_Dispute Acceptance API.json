        "parameters": [
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Accepts the dispute identified by RES-100045. This operation confirms that the disputing party agrees to the terms and conditions associated with the dispute resolution process.",
