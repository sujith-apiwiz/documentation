          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to freeze a membership. It includes necessary details such as the member's ID and the duration of the freeze. Ensure that all required fields are provided for successful processing.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceFitnessMembershipsFreezeRequest"
              }
            }
          }
        },
        "responses": {
