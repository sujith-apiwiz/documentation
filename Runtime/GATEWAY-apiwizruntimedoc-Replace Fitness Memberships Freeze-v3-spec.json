      "put": {
        "tags": [
          "Membership Management"
        ],
        "summary": "Freeze a membership temporarily.",
        "description": "This endpoint allows you to temporarily freeze a membership for a specified period. The freeze prevents the account from being charged and suspends access to membership privileges until it is reactivated.",
        "operationId": "replaceFitnessMembershipsFreeze",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
