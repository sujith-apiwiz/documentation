      "MICROSERVICE_TEST-DEV_createTicket-CreateTicketRequest": {
        "title": "Ticket Creation Request",
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "Unique identifier for the ticket.",
            "example": "BT-676276"
          },
          "busId": {
            "type": "string",
            "description": "Identifier for the bus associated with the ticket.",
            "example": "BUS-5633"
          },
          "routeId": {
            "type": "string",
            "description": "Identifier for the route taken by the bus.",
            "example": "RT-926"
          },
          "passengerName": {
            "type": "string",
            "description": "Name of the passenger holding the ticket.",
            "example": "Wei Kumar"
          },
          "seatNumber": {
            "type": "integer",
            "description": "Number of the seat assigned to the passenger.",
            "format": "int32",
            "example": 42
          },
          "origin": {
            "type": "string",
            "description": "Starting point of the journey.",
            "example": "West Depot"
          },
          "destination": {
            "type": "string",
            "description": "Ending point of the journey.",
            "example": "Mall Junction"
          },
          "fare": {
            "type": "number",
            "description": "Cost of the ticket.",
            "example": 34.62
          },
          "departureTime": {
            "type": "string",
            "description": "Scheduled departure time of the bus.",
            "example": "2026-07-18T23:30:52.162Z"
          }
        },
        "description": "Schema for creating a new ticket in the system.",
        "example": {
          "ticketId": "BT-676276",
          "busId": "BUS-5633",
          "routeId": "RT-926",
          "passengerName": "Wei Kumar",
          "seatNumber": 42,
