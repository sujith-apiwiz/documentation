<?xml version="1.0" encoding="UTF-8" standalone="no"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:apiwiz="urn:apiwiz:wsdl" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://example.com/orders" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="AdhocBDAISOAP" targetNamespace="http://example.com/orders"><wsdl:documentation>AdhocBDAISOAP provides a SOAP web service that facilitates order retrieval for businesses looking to manage their orders efficiently. The primary operation, GetOrder, allows clients to fetch specific orders based on their unique identifiers. Typical consumers include businesses and applications that require easy access to order information in real-time.</wsdl:documentation>
      
    <wsdl:types>
            
        <xsd:schema elementFormDefault="qualified" targetNamespace="http://example.com/orders">
            <xsd:element name="GetOrderRequest"><xsd:annotation><xsd:documentation>This element represents the request to retrieve an order, containing specific order identification.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="orderId" type="xsd:int"><xsd:annotation><xsd:documentation>This child element specifies the unique identifier of the order being requested.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetOrderResponse"><xsd:annotation><xsd:documentation>This element contains the details of the order retrieved, including the order's current status and total amount.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="orderId" type="xsd:int"><xsd:annotation><xsd:documentation>This child element indicates the unique identifier of the order that has been retrieved.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="status" type="xsd:string"><xsd:annotation><xsd:documentation>This child element provides the current processing status of the order.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="total" type="xsd:decimal"><xsd:annotation><xsd:documentation>This child element reflects the total amount for the order.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetOrderFault"><xsd:annotation><xsd:documentation>This element provides information about any faults or errors encountered during the order retrieval process.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="faultcode" type="xsd:string"><xsd:annotation><xsd:documentation>This child element specifies the code associated with the fault that occurred.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="faultstring" type="xsd:string"><xsd:annotation><xsd:documentation>This child element holds a descriptive message about the fault.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
          
    </wsdl:types>
      
    <wsdl:message name="GetOrderFaultMessage"><wsdl:documentation>This message delivers fault information in case of an error encountered while processing the order retrieval.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderFault" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:message name="GetOrderResponseMessage"><wsdl:documentation>This message carries the details of the order including its status and total, as a response to the request.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderResponse" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:message name="GetOrderRequestMessage"><wsdl:documentation>This message carries the order identification information as a request to fetch order details.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderRequest" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:portType name="OrderServicePortType">
            
        <wsdl:operation name="GetOrder"><wsdl:documentation>This operation retrieves order details based on a specific order identifier provided in the request.</wsdl:documentation>
                  
            <wsdl:input message="tns:GetOrderRequestMessage">
    </wsdl:input>
                  
            <wsdl:output message="tns:GetOrderResponseMessage">
    </wsdl:output>
                  
            <wsdl:fault message="tns:GetOrderFaultMessage" name="GetOrderFault">
    </wsdl:fault>
                
        </wsdl:operation>
          
    </wsdl:portType>
      
    <wsdl:binding name="OrderServiceBinding" type="tns:OrderServicePortType">
            
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            
        <wsdl:operation name="GetOrder">
                  
            <soap:operation soapAction="http://example.com/orders/GetOrder" style="document"/>
                  
            <wsdl:input>
                        
                <soap:body use="literal"/>
                      
            </wsdl:input>
                  
            <wsdl:output>
                        
                <soap:body use="literal"/>
                      
            </wsdl:output>
                  
            <wsdl:fault name="GetOrderFault">
                        
                <soap:fault name="GetOrderFault" use="literal"/>
                      
            </wsdl:fault>
                
        </wsdl:operation>
          
    </wsdl:binding>
      
    <wsdl:service name="OrderServiceService">
            
        <wsdl:port apiwiz:environment="soapTest" binding="tns:OrderServiceBinding" name="OrderServicePort">
                  
            <soap:address location="https://api.adhoctest.example.com/adhoctest/soap/OrderService"/>
                
        </wsdl:port>
          
    </wsdl:service>
    
</wsdl:definitions>