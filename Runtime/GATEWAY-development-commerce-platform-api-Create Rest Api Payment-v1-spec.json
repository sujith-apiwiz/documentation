  "components": {
    "schemas": {
      "CreateRestApiPaymentRequest": {
        "title": "Payment Request",
        "required": [
          "amount",
          "currency",
          "orderId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "The unique identifier for the order associated with this payment.",
            "example": "ORD-92791"
          },
          "amount": {
            "type": "integer",
            "description": "The amount of money to be paid, represented as an integer in cents.",
            "format": "int32",
            "example": 7895
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the payment is made, represented as an ISO 4217 currency code.",
            "example": "INR"
          }
        },
        "description": "This schema represents the request body for initiating a payment operation.",
        "example": {
          "orderId": "ORD-92791",
          "amount": 7895,
          "currency": "INR"
        }
      },
      "CreateRestApiPaymentResponse_200": {
        "title": "Payment Response",
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "description": "The unique identifier for the payment.",
            "example": "pay_6315ccq1tjczh0"
          },
          "orderId": {
            "type": "string",
            "description": "The unique identifier for the order associated with the payment.",
            "example": "ORD-92791"
          },
          "amount": {
            "type": "integer",
            "description": "The amount of money that was processed in the payment.",
            "format": "int32",
            "example": 7895
          },
          "currency": {
            "type": "string",
            "description": "The currency code in which the payment was made.",
            "example": "INR"
          },
          "status": {
            "type": "string",
            "description": "The current status of the payment.",
            "example": "CAPTURED"
          },
          "method": {
            "description": "Details about the payment method used for the transaction.",
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "authCode": {
            "type": "string",
            "description": "The authorization code returned by the payment processor.",
            "example": "476707"
          },
          "gatewayRef": {
            "type": "string",
            "description": "The reference identifier provided by the payment gateway.",
            "example": "gw_8pcsqutlco"
          },
          "processedAt": {
            "type": "string",
            "description": "The timestamp indicating when the payment was processed.",
            "example": "2026-10-27T16:20:22.732112Z"
          }
        },
        "description": "This schema represents the response returned after a successful payment operation.",
        "example": {
          "paymentId": "pay_6315ccq1tjczh0",
          "orderId": "ORD-92791",
          "amount": 7895,
          "currency": "INR",
          "status": "CAPTURED",
          "method": {
            "type": "CARD",
            "brand": "VISA",
            "last4": "3279"
          },
          "authCode": "476707",
          "gatewayRef": "gw_8pcsqutlco",
          "processedAt": "2026-10-27T16:20:22.732112Z"
        }
      },
      "PaymentMethod": {
        "title": "Payment Method",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of payment method (e.g., credit card, debit card)."
          },
          "brand": {
            "type": "string",
            "description": "The brand of the payment method (e.g., Visa, MasterCard)."
          },
          "last4": {
            "type": "string",
