    "schemas": {
      "CreateRestApiPaymentRequest": {
        "title": "Payment Request",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "The unique identifier for the order associated with the payment.",
            "example": "ORD-87595"
          },
          "amount": {
            "type": "integer",
            "description": "The amount of money to be processed, represented in the smallest currency unit (e.g., cents for USD).",
            "format": "int32",
            "example": 181450
          },
          "currency": {
            "type": "string",
            "description": "The currency code (ISO 4217 format) in which the payment amount is specified.",
            "example": "INR"
          }
        },
        "description": "Schema representing the request body for processing a payment operation.",
        "example": {
          "orderId": "ORD-87595",
          "amount": 181450,
          "currency": "INR"
        }
      },
      "CreateRestApiPaymentResponse_200": {
        "title": "Payment Response",
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "description": "Unique identifier for the payment.",
            "example": "pay_35r20zmiogb9jc"
          },
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the associated order.",
            "example": "ORD-87595"
          },
          "amount": {
            "type": "integer",
            "description": "The amount of the payment.",
            "format": "int32",
            "example": 181450
          },
          "currency": {
            "type": "string",
            "description": "The currency code for the payment, e.g., 'USD'.",
            "example": "INR"
          },
          "status": {
            "type": "string",
            "description": "The current status of the payment.",
            "example": "CAPTURED"
          },
          "method": {
            "description": "The payment method used for the transaction.",
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "authCode": {
            "type": "string",
            "description": "Authorization code returned from the payment gateway.",
            "example": "989458"
          },
          "gatewayRef": {
            "type": "string",
            "description": "Reference identifier from the payment gateway.",
            "example": "gw_2o1v82z4x3"
          },
          "processedAt": {
            "type": "string",
            "description": "Timestamp indicating when the payment was processed.",
            "example": "2026-10-28T14:00:36.907485Z"
          }
        },
        "description": "This schema represents the response for a successful payment operation.",
        "example": {
          "paymentId": "pay_35r20zmiogb9jc",
          "orderId": "ORD-87595",
          "amount": 181450,
          "currency": "INR",
          "status": "CAPTURED",
          "method": {
            "type": "CARD",
            "brand": "MASTERCARD",
            "last4": "8347"
          },
          "authCode": "989458",
          "gatewayRef": "gw_2o1v82z4x3",
          "processedAt": "2026-10-28T14:00:36.907485Z"
        }
      },
      "PaymentMethod": {
        "title": "Payment Method",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of the payment method, e.g., credit card, PayPal.",
            "example": "credit_card"
          },
          "brand": {
            "type": "string",
            "description": "Brand of the payment method, e.g., Visa, Mastercard.",
            "example": "Visa"
          },
          "last4": {
            "type": "string",
            "description": "Last four digits of the payment method, relevant for card payments.",
            "example": "1234"
          }
        },
        "description": "This schema represents the payment method details used in a transaction."
