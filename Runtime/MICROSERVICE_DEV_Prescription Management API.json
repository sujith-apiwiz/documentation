            "example": "250mg"
          },
          "frequency": {
            "type": "string",
            "description": "How often the medication should be taken.",
            "example": "Once daily"
          },
          "prescribedBy": {
            "type": "string",
            "description": "Identifier of the healthcare professional who prescribed the medication.",
            "example": "DOC-2595"
          },
          "issuedDate": {
            "type": "string",
            "description": "Date on which the prescription was issued.",
            "example": "2026-07-13T09:21:31.835Z"
          }
        },
        "description": "Schema for creating a new prescription. Contains all necessary details regarding the prescription, including patient and medication information.",
        "example": {
          "prescriptionId": "RX-514013",
          "patientId": "PAT-564846",
          "medication": "Amoxicillin",
          "dosage": "250mg",
          "frequency": "Once daily",
          "prescribedBy": "DOC-2595",
          "issuedDate": "2026-07-13T09:21:31.835Z"
