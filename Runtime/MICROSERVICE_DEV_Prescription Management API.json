        "title": "Prescription Creation Request",
        "type": "object",
        "properties": {
          "prescriptionId": {
            "type": "string",
            "description": "Unique identifier for the prescription.",
            "example": "RX-514013"
          },
          "patientId": {
            "type": "string",
            "description": "Unique identifier for the patient receiving the prescription.",
            "example": "PAT-564846"
