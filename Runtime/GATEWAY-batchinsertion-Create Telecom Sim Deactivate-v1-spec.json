  "paths": {
    "/telecom/v1/sim/deactivate": {
      "post": {
        "tags": [
          "SIM Management"
        ],
        "summary": "Deactivate a SIM card.",
        "description": "This endpoint allows you to deactivate a specific SIM card associated with a user account, preventing further usage and preventing billing for usage on that SIM until it is reactivated.",
        "operationId": "createTelecomSimDeactivate",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request is used to deactivate a SIM card. It requires specific parameters to identify the SIM card that needs to be deactivated.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTelecomSimDeactivateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The SIM has been deactivated successfully.",
            "headers": {
              "x-processing-time": {
                "$ref": "#/components/headers/x-processing-time"
              }
            },
            "content": {
