          "startDate": {
            "type": "string",
            "description": "The start date of the insurance coverage.",
            "example": "2026-07-16"
          },
          "endDate": {
            "type": "string",
            "description": "The end date of the insurance coverage.",
            "example": "2027-07-16"
          },
          "message": {
            "type": "string",
            "description": "Additional information or messages related to the appointment operation.",
            "example": "Insurance policy created successfully."
