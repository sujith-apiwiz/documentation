  "components": {
    "schemas": {
      "CreateApiInventoryReserveRequest": {
        "title": "Inventory Reserve Request",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "The unique identifier for the order associated with the inventory reservation.",
            "example": "ORD-73035"
          },
          "sku": {
            "type": "string",
            "description": "The stock keeping unit (SKU) identifier for the inventory item being reserved.",
            "example": "COF-4120"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the inventory item to reserve.",
            "format": "int32",
            "example": 1
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier for the warehouse from which the inventory item will be reserved.",
            "example": "WH-DEL-03"
          }
        },
        "description": "Schema representing the request body for reserving inventory items.",
        "example": {
          "orderId": "ORD-73035",
          "sku": "COF-4120",
          "qty": 1,
          "warehouse": "WH-DEL-03"
        }
      },
      "CreateApiInventoryReserveResponse_200": {
        "title": "Reserve Operations Response",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status of the request.",
            "example": "success"
          },
          "data": {
