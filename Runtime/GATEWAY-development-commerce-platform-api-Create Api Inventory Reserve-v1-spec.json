  "components": {
    "schemas": {
      "CreateApiInventoryReserveRequest": {
        "title": "Inventory Reserve Request",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the order.",
            "example": "ORD-97261"
          },
          "sku": {
            "type": "string",
            "description": "Stock Keeping Unit identifier for the item.",
            "example": "BAG-5518"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the item to reserve.",
            "format": "int32",
            "example": 1
          },
          "warehouse": {
            "type": "string",
            "description": "Identifier of the warehouse from which to reserve the inventory.",
            "example": "WH-MUM-02"
          }
        },
        "description": "Schema representing the request body for reserving inventory operations.",
        "example": {
          "orderId": "ORD-97261",
          "sku": "BAG-5518",
          "qty": 1,
          "warehouse": "WH-MUM-02"
        }
      },
      "CreateApiInventoryReserveResponse_200": {
        "title": "Inventory Reserve Response",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status of the reservation operation.",
            "example": "success"
          },
          "data": {
            "description": "The data object containing details about the reservation.",
            "$ref": "#/components/schemas/ReservationData"
          },
          "requestId": {
            "type": "string",
            "description": "A unique identifier for the request.",
            "example": "req_0yz1svbh1a9a"
          }
        },
        "description": "This schema represents the response structure for successful inventory reservation operations.",
        "example": {
          "status": "success",
          "data": {
            "reservationId": "RSV-O9XHXCFG",
            "orderId": "ORD-97261",
            "sku": "BAG-5518",
            "qty": 1,
            "warehouse": "WH-MUM-02",
            "status": "RESERVED",
            "expiresAt": "2026-10-28T14:30:37.457753Z"
          },
          "requestId": "req_0yz1svbh1a9a"
        }
      },
      "ReservationData": {
        "title": "Reservation Data",
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "The unique identifier for the reservation.",
            "example": "res_123456"
          },
          "orderId": {
            "type": "string",
            "description": "The unique identifier for the associated order.",
            "example": "ord_123456"
          },
          "sku": {
            "type": "string",
            "description": "The stock keeping unit identifier for the item being reserved.",
            "example": "sku_123456"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the item to be reserved.",
            "format": "int32",
            "example": 10
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier for the warehouse where the item is stored.",
            "example": "wh_1"
          },
          "status": {
            "type": "string",
            "description": "The current status of the reservation.",
            "example": "reserved"
          },
          "expiresAt": {
            "type": "string",
            "description": "The expiration date and time for the reservation.",
            "example": "2023-10-31T10:00:00Z"
          }
        },
        "description": "This schema represents the data related to a specific inventory reservation."
      }
