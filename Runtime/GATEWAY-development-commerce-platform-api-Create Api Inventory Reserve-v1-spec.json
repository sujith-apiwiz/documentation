          "requestId": {
            "type": "string",
            "description": "Unique identifier for the request.",
            "example": "req_05levzptkxxv"
          }
        },
        "description": "Response schema for the reserve operations POST request.",
        "example": {
          "status": "success",
          "data": {
            "reservationId": "RSV-0MKLF1FF",
            "orderId": "ORD-73035",
            "sku": "COF-4120",
            "qty": 1,
            "warehouse": "WH-DEL-03",
            "status": "RESERVED",
            "expiresAt": "2026-10-28T16:50:10.398634Z"
          },
          "requestId": "req_05levzptkxxv"
        }
      },
      "ReserveData": {
        "title": "Reservation Data",
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Unique identifier for the reservation.",
            "example": "resv_123456"
          },
          "orderId": {
            "type": "string",
            "description": "The identifier of the order associated with the reservation.",
            "example": "order_123456"
          },
          "sku": {
            "type": "string",
            "description": "Stock Keeping Unit associated with the reservation.",
            "example": "SKU123456"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of items reserved.",
            "format": "int32",
            "example": 10
          },
          "warehouse": {
            "type": "string",
            "description": "The warehouse from which items are reserved.",
            "example": "WH1"
          },
          "status": {
            "type": "string",
            "description": "The status of the reservation.",
            "example": "reserved"
          },
          "expiresAt": {
            "type": "string",
            "description": "The expiration date and time of the reservation.",
            "example": "2023-10-31T23:59:59Z"
          }
        },
        "description": "Details of the reservation made during the operation."
      }
