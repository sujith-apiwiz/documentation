  "paths": {
    "/payments/v1/payments/capture": {
      "post": {
        "tags": [
          "Payment Processing"
        ],
        "summary": "Capture a payment after authorization.",
        "description": "This endpoint is used to capture previously authorized payments. Upon successful capture, the funds will be transferred from the customer's account to the merchant\u2019s account. This operation must be performed within the time frame specified by the payment processor.",
        "operationId": "createPaymentsPaymentsCapture",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to capture a payment that has been authorized. The provided information must include sufficient details to clearly identify the payment and specify the capture amount.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentsPaymentsCaptureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The payment capture request was successful and the transaction is now completed.",
            "headers": {
              "x-processing-time": {
                "$ref": "#/components/headers/x-processing-time"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePaymentsPaymentsCaptureResponse_200"
                }
              }
            }
          }
        },
        "callbacks": {},
        "security": [],
        "servers": []
      },
      "servers": [],
      "parameters": []
    }
  },
