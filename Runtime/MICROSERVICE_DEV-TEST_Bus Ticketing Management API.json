            "format": "int32",
            "example": 10
          },
          "origin": {
            "type": "string",
            "description": "Origin location of the bus journey.",
            "example": "Airport Hub"
          },
          "destination": {
            "type": "string",
            "description": "Destination location of the bus journey.",
            "example": "East Terminal"
          },
          "fare": {
            "type": "number",
            "description": "The fare amount for the ticket.",
            "example": 23.48
          },
          "departureTime": {
            "type": "string",
            "description": "Scheduled departure time for the bus.",
            "example": "2026-07-31T21:24:56.938Z"
          }
        },
