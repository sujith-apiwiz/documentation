  "paths": {
    "/ecommerce/v4/cart/merge": {
      "put": {
        "tags": [
          "Shopping Cart"
        ],
        "summary": "Merge the contents of multiple carts into a single cart.",
        "description": "This endpoint allows users to combine items from different shopping carts into one cart. It's useful for ensuring that all items are consolidated before proceeding to checkout.",
        "operationId": "replaceEcommerceCartMerge",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Merge the contents of two shopping carts. This operation combines the items from the client's current cart with the items from another specified cart. The purpose is to consolidate the items for a seamless shopping experience.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceEcommerceCartMergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The cart has been successfully merged.",
            "headers": {
              "x-processing-time": {
                "$ref": "#/components/headers/x-processing-time"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplaceEcommerceCartMergeResponse_200"
                }
              }
            }
          }
        },
        "callbacks": {},
