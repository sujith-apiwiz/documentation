            "example": "HTL-8631"
          },
          "guestName": {
            "type": "string",
            "description": "Name of the guest who made the booking.",
            "example": "Sofia Doe"
          },
          "roomType": {
            "type": "string",
            "description": "Type of room booked (e.g., single, double, suite).",
            "example": "DOUBLE"
          },
          "checkInDate": {
            "type": "string",
            "description": "Date of check-in in ISO 8601 format.",
            "example": "2026-08-06T17:27:39.543Z"
          },
          "checkOutDate": {
            "type": "string",
            "description": "Date of check-out in ISO 8601 format.",
            "example": "2026-08-06T22:13:12.190Z"
          },
          "guests": {
            "type": "integer",
            "description": "Number of guests for the booking.",
            "format": "int32",
            "example": 3
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount for the booking in the specified currency.",
            "example": 1462.73
          },
          "currency": {
            "type": "string",
            "description": "Currency code (e.g., USD, EUR) for the total amount.",
            "example": "GBP"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Current payment status of the booking (e.g., paid, pending).",
            "example": "REFUNDED"
          }
        },
