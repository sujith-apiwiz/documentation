            "example": "SKU12345"
          },
          "Name": {
            "type": "string",
            "description": "Name of the item.",
            "example": "Widget"
          },
          "Qty": {
            "type": "integer",
            "description": "Quantity of the item ordered.",
            "format": "int32",
            "example": 2
          },
          "UnitPrice": {
            "type": "integer",
            "description": "Price per unit of the item.",
            "format": "int32",
            "example": 50
          },
          "LineTotal": {
            "type": "integer",
            "description": "Total price for the line item (Qty * UnitPrice).",
            "format": "int32",
            "example": 100
          }
        },
        "description": "Schema representing an individual item in an order."
      },
