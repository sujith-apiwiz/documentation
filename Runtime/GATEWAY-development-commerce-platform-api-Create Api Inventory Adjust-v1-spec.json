                "description": "The available quantity of the item for sale.",
                "format": "int32",
                "example": 40
              },
              "reorderLevel": {
                "type": "integer",
                "description": "The reorder level for the inventory item.",
                "format": "int32",
                "example": 20
              },
              "updatedAt": {
                "type": "string",
                "description": "Timestamp of the last update to the inventory item.",
                "example": "2023-10-01T12:00:00Z"
              },
              "adjustment": {
                "$ref": "#/components/schemas/AdjustmentDetails"
              },
              "requestId": {
                "type": "string",
                "description": "Unique identifier for the request.",
                "example": "REQ123456"
              }
            },
            "description": "Detailed information about the inventory item being adjusted.",
            "example": {
              "sku": "MON-6603",
              "name": "Dell S2725QC 27-inch 4K Monitor",
              "warehouse": "WH-DEL-03",
              "onHand": 35,
              "reserved": 6,
              "available": 29,
              "reorderLevel": 25,
              "updatedAt": "2026-10-28T05:00:37.396866Z",
              "adjustment": {
                "delta": 6,
