              },
              "name": {
                "type": "string",
                "description": "The name of the inventory item.",
                "example": "Widget A"
              },
              "warehouse": {
                "type": "string",
                "description": "Identifier for the warehouse where the item is located.",
                "example": "WH1"
              },
              "onHand": {
