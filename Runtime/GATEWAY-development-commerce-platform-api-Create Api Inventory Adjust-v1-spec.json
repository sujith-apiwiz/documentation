          },
          "requestId": {
            "type": "string",
            "description": "A unique identifier for the request.",
            "example": "req_9gqs211lq6cm"
          }
        },
        "description": "Schema representing the response structure for the inventory adjustment operation.",
        "example": {
          "status": "success",
          "data": {
            "sku": "AUD-2210",
            "name": "Sony WH-1000XM5 Wireless Headphones",
            "warehouse": "WH-HYD-04",
            "onHand": 32,
            "reserved": 6,
            "available": 26,
            "reorderLevel": 25,
            "updatedAt": "2026-10-27T18:02:38.700698Z",
            "adjustment": {
              "delta": 6,
              "reason": "cycle-count",
              "adjustmentId": "ADJ-540355",
              "at": "2026-10-28T14:02:38.700680Z"
            }
          },
          "requestId": "req_9gqs211lq6cm"
        }
      },
      "InventoryAdjustmentData": {
        "title": "Inventory Adjustment Data",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The Stock Keeping Unit identifier for the inventory item.",
            "example": "SKU123456"
          },
          "name": {
            "type": "string",
            "description": "The name of the inventory item.",
            "example": "Product Name"
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier of the warehouse where the item is stored.",
            "example": "Warehouse A"
          },
          "onHand": {
            "type": "integer",
            "description": "The total quantity of the item currently on hand.",
            "format": "int32",
            "example": 100
          },
          "reserved": {
            "type": "integer",
            "description": "The quantity of the item that is reserved and not available for sale.",
            "format": "int32",
            "example": 10
          },
          "available": {
            "type": "integer",
            "description": "The quantity of the item available for sale.",
            "format": "int32",
            "example": 90
          },
          "reorderLevel": {
            "type": "integer",
            "description": "The level at which the inventory item should be reordered.",
            "format": "int32",
            "example": 20
          },
          "updatedAt": {
            "type": "string",
            "description": "The timestamp when the inventory item was last updated.",
            "example": "2023-10-01T12:00:00Z"
          },
          "adjustment": {
            "$ref": "#/components/schemas/AdjustmentDetails"
          }
        },
        "description": "Schema containing detailed information about the inventory adjustment.",
        "example": {
          "sku": "SKU123456",
          "name": "Product Name",
          "warehouse": "Warehouse A",
          "onHand": 100,
          "reserved": 10,
          "available": 90,
          "reorderLevel": 20,
          "updatedAt": "2023-10-01T12:00:00Z",
          "adjustment": {
            "delta": 5,
            "reason": "Stock Correction",
            "adjustmentId": "adj-78910",
            "at": "2023-10-01T12:00:00Z"
          }
        }
      },
      "AdjustmentDetails": {
        "title": "Adjustment Details",
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer",
            "description": "The amount of change made to the inventory.",
            "format": "int32",
            "example": 5
          },
          "reason": {
            "type": "string",
            "description": "The reason for the adjustment.",
            "example": "Stock Correction"
          },
          "adjustmentId": {
            "type": "string",
            "description": "The unique identifier for the specific adjustment.",
            "example": "adj-78910"
          },
          "at": {
            "type": "string",
            "description": "The timestamp when the adjustment was made.",
            "example": "2023-10-01T12:00:00Z"
          }
        },
        "description": "Schema providing details about the inventory adjustment made.",
        "example": {
          "delta": 5,
          "reason": "Stock Correction",
          "adjustmentId": "adj-78910",
          "at": "2023-10-01T12:00:00Z"
        }
      }
