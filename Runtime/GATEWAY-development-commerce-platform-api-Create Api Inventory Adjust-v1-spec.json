  "components": {
    "schemas": {
      "CreateApiInventoryAdjustRequest": {
        "title": "Inventory Adjustment Request",
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer",
            "description": "The quantity to adjust the inventory by. Positive numbers increase the inventory, while negative numbers decrease it.",
            "format": "int32",
            "example": 25
          },
          "reason": {
            "type": "string",
            "description": "A string describing the reason for the inventory adjustment.",
            "example": "cycle-count"
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier for the warehouse where the inventory adjustment is taking place.",
            "example": "WH-DEL-03"
          }
        },
        "description": "Schema representing the request body for adjusting inventory operations.",
        "example": {
          "delta": 25,
          "reason": "cycle-count",
          "warehouse": "WH-DEL-03"
        }
      },
      "CreateApiInventoryAdjustResponse_200": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status of the operation.",
            "example": "success"
          },
          "data": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string",
                "description": "The Stock Keeping Unit identifier for the item.",
                "example": "BAG-5518"
              },
              "name": {
                "type": "string",
                "description": "The name of the inventory item.",
                "example": "Premium Bag"
              },
              "warehouse": {
                "type": "string",
                "description": "The warehouse where the item is stored.",
                "example": "Warehouse A"
              },
              "onHand": {
                "type": "integer",
                "description": "The total quantity of the item currently on hand.",
                "format": "int32",
                "example": 50
              },
              "reserved": {
                "type": "integer",
                "description": "The quantity of the item currently reserved.",
                "format": "int32",
                "example": 5
              },
              "available": {
                "type": "integer",
                "description": "The quantity of the item available for sale.",
                "format": "int32",
                "example": 45
              },
              "reorderLevel": {
                "type": "integer",
                "description": "The quantity level that triggers a reorder of the item.",
                "format": "int32",
                "example": 10
              },
              "updatedAt": {
                "type": "string",
                "description": "The timestamp of when the item was last updated.",
                "example": "2023-10-01T12:00:00Z"
              },
              "adjustment": {
                "$ref": "#/components/schemas/Adjustment"
              },
              "requestId": {
                "type": "string",
                "description": "A unique identifier for the request.",
                "example": "req-123456"
              }
            },
            "description": "Contains details of the inventory item after adjustment.",
            "example": {
              "sku": "BAG-5518",
              "name": "Wildcraft 35L Laptop Backpack",
              "warehouse": "WH-DEL-03",
              "onHand": 94,
              "reserved": 7,
              "available": 87,
              "reorderLevel": 25,
              "updatedAt": "2026-10-27T06:20:10.348401Z",
              "adjustment": {
                "delta": 25,
                "reason": "cycle-count",
                "adjustmentId": "ADJ-134232",
                "at": "2026-10-28T16:20:10.348386Z"
              }
            }
          }
        },
        "example": {
          "status": "success",
          "data": {
