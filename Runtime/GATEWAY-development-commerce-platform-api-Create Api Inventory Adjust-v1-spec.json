    "schemas": {
      "CreateApiInventoryAdjustRequest": {
        "title": "Inventory Adjustment Request",
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer",
            "description": "The amount of inventory adjustment to apply. This should be a positive or negative integer.",
            "format": "int32",
            "example": 6
          },
          "reason": {
            "type": "string",
            "description": "The reason for the inventory adjustment, providing context for the change.",
            "example": "cycle-count"
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier or name of the warehouse where the inventory adjustment is being made.",
            "example": "WH-HYD-04"
          }
        },
        "description": "Schema representing a request body for adjusting inventory operations. It contains details about the adjustment such as delta, reason, and associated warehouse.",
        "example": {
          "delta": 6,
          "reason": "cycle-count",
          "warehouse": "WH-HYD-04"
        }
      },
      "CreateApiInventoryAdjustResponse_200": {
