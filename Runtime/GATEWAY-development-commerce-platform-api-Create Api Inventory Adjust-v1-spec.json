            "format": "int32",
            "example": 6
          },
          "reason": {
            "type": "string",
            "description": "The reason for the inventory adjustment.",
            "example": "inbound-grn"
          },
          "warehouse": {
            "type": "string",
            "description": "The identifier for the warehouse where the adjustment is made.",
            "example": "WH-DEL-03"
          }
        },
        "description": "Schema representing a request body for adjusting inventory operations.",
        "example": {
          "delta": 6,
          "reason": "inbound-grn",
          "warehouse": "WH-DEL-03"
        }
      },
