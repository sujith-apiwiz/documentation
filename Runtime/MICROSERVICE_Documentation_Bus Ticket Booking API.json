      "MICROSERVICE_Documentation_createTicket-CreateTicketRequest": {
        "title": "Ticket Request Body",
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "The unique identifier for the ticket.",
            "example": "BT-430053"
          },
          "busId": {
            "type": "string",
            "description": "The unique identifier for the bus associated with the ticket.",
            "example": "BUS-9258"
          },
          "routeId": {
            "type": "string",
            "description": "The unique identifier for the route associated with the ticket.",
            "example": "RT-384"
          },
          "passengerName": {
            "type": "string",
            "description": "The name of the passenger who purchased the ticket.",
            "example": "Fatima Kumar"
          },
          "seatNumber": {
            "type": "integer",
            "description": "The seat number assigned to the passenger.",
            "format": "int32",
            "example": 12
          },
          "origin": {
            "type": "string",
            "description": "The origin location of the bus route.",
            "example": "Airport Hub"
          },
          "destination": {
            "type": "string",
            "description": "The destination location of the bus route.",
            "example": "South Station"
          },
          "fare": {
            "type": "number",
            "description": "The fare amount for the ticket.",
            "example": 4.81
          },
          "departureTime": {
            "type": "string",
            "description": "The scheduled departure time for the bus.",
            "example": "2026-08-04T15:25:01.554Z"
          }
        },
        "description": "Schema representing the request body for creating a new ticket.",
        "example": {
          "ticketId": "BT-430053",
          "busId": "BUS-9258",
          "routeId": "RT-384",
          "passengerName": "Fatima Kumar",
          "seatNumber": 12,
          "origin": "Airport Hub",
          "destination": "South Station",
          "fare": 4.81,
          "departureTime": "2026-08-04T15:25:01.554Z"
        }
      },
