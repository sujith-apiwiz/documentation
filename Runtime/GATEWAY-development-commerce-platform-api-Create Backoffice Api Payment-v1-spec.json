                    "format": "int32",
                    "example": 1000
                  },
                  "Currency": {
                    "type": "string",
                    "description": "The currency in which the payment was made, represented by its ISO code.",
                    "example": "USD"
                  },
                  "Status": {
                    "type": "string",
                    "description": "The current status of the payment (e.g., 'completed', 'pending').",
                    "example": "completed"
                  },
                  "Method": {
                    "$ref": "#/components/schemas/PaymentMethod"
                  },
                  "AuthCode": {
                    "type": "string",
                    "description": "Authorization code received for the transaction.",
                    "example": "auth_123456"
                  },
                  "GatewayRef": {
                    "type": "string",
                    "description": "Reference identifier from the payment gateway.",
                    "example": "gateway_123456"
                  },
                  "ProcessedAt": {
                    "type": "string",
                    "description": "Timestamp indicating when the payment was processed.",
                    "example": "2023-10-01T10:00:00Z"
                  }
                },
                "description": "The main body of the payment response containing payment details.",
                "example": {
                  "PaymentId": "pay_123456",
                  "OrderId": "ord_123456",
                  "Amount": 1000,
                  "Currency": "USD",
                  "Status": "completed",
                  "Method": {
                    "Type": "credit_card",
                    "Brand": "Visa",
                    "Last4": "1234"
                  },
                  "AuthCode": "auth_123456",
                  "GatewayRef": "gateway_123456",
                  "ProcessedAt": "2023-10-01T10:00:00Z"
                }
              }
            },
            "description": "Detailed response information about the payment operation.",
