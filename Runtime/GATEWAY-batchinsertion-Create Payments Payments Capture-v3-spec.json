        ],
        "summary": "Capture a payment.",
        "description": "This endpoint allows you to capture a payment that has been authorized. It finalizes the transaction and transfers the funds from the customer's account to the merchant's account.",
        "operationId": "createPaymentsPaymentsCapture",
        "parameters": [
