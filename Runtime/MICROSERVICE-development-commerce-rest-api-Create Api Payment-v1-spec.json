            "example": "pay_wqr7s1iu9zoyny"
          },
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the associated order.",
            "example": "ORD-95278"
          },
          "amount": {
            "type": "integer",
            "description": "Amount of money for the payment in the smallest currency unit (e.g., cents).",
            "format": "int32",
            "example": 42624
          },
          "currency": {
            "type": "string",
            "description": "Currency code in which the payment was made (e.g., USD, EUR).",
            "example": "INR"
          },
