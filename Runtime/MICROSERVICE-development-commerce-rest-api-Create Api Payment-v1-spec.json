          },
          "method": {
            "description": "Details of the payment method used.",
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "authCode": {
            "type": "string",
            "description": "Authorization code returned by the payment gateway.",
            "example": "904580"
          },
          "gatewayRef": {
            "type": "string",
            "description": "Reference identifier provided by the payment gateway.",
            "example": "gw_3ekqvjirsz"
          },
          "processedAt": {
            "type": "string",
            "description": "Timestamp indicating when the payment was processed.",
            "example": "2026-10-28T14:00:33.494789Z"
          }
        },
        "description": "Response schema representing the details of a payment operation.",
        "example": {
          "paymentId": "pay_wqr7s1iu9zoyny",
          "orderId": "ORD-95278",
          "amount": 42624,
          "currency": "INR",
          "status": "CAPTURED",
