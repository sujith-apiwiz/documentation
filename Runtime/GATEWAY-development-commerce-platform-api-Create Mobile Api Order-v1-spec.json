            }
          },
          "total": {
            "type": "integer",
            "description": "The total amount for the order.",
            "format": "int32",
            "example": 1947
          }
        },
        "description": "The request body for creating a new order.",
        "example": {
          "user_id": 1006,
          "items": [
            {
              "sku": "COF-4120",
              "qty": 3
            }
          ],
          "total": 1947
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The Stock Keeping Unit identifier for the item.",
            "example": "SKU001"
          },
          "name": {
            "type": "string",
            "description": "The name of the item.",
            "example": "Product 1"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the item ordered.",
            "format": "int32",
            "example": 2
          },
          "unit_price": {
            "type": "integer",
            "description": "The price per unit of the item.",
            "format": "int32",
            "example": 10
          },
          "line_total": {
            "type": "integer",
            "description": "The total price for the quantity of the item ordered (qty multiplied by unit_price).",
            "format": "int32",
            "example": 20
          }
        },
        "description": "Details about an individual item in the order."
      },
      "CreateMobileApiOrderResponse_200": {
        "type": "object",
        "properties": {
          "result": {
            "description": "Contains details about the created order.",
            "$ref": "#/components/schemas/OrderResult"
          },
          "status": {
            "type": "string",
            "description": "The status of the request.",
            "example": "OK"
          },
          "org_code": {
            "type": "string",
            "description": "The organization code associated with the order.",
            "example": "ACME-IN-01"
          },
          "request_id": {
            "type": "string",
            "description": "A unique identifier for tracking the request.",
            "example": "req_qsljqzckj0np"
          }
        },
        "description": "Response object for the successful creation of an order.",
        "example": {
          "result": {
            "order_id": "ORD-85369",
            "user_id": 1006,
            "status": "CONFIRMED",
            "items": [
              {
                "sku": "COF-4120",
                "name": "Blue Tokai Cold Brew Coffee 500g",
                "qty": 3,
                "unit_price": 649,
                "line_total": 1947
              }
            ],
            "total": 1947,
            "currency": "INR",
            "placed_at": "2026-10-23T20:43:47.148473Z",
            "estimated_delivery": "2026-10-28"
          },
          "status": "OK",
          "org_code": "ACME-IN-01",
          "request_id": "req_qsljqzckj0np"
        }
      },
      "OrderResult": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "The unique identifier for the order.",
            "example": "ORDER789"
          },
          "user_id": {
            "type": "integer",
            "description": "The unique identifier for the user who placed the order.",
            "format": "int32",
            "example": 1
          },
          "status": {
            "type": "string",
            "description": "The current status of the order.",
            "example": "completed"
          },
          "items": {
            "type": "array",
            "description": "A list of items included in the order.",
            "example": [
              {
                "sku": "SKU001",
                "name": "Product 1",
                "qty": 2,
                "unit_price": 10,
                "line_total": 20
              }
            ],
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "total": {
            "type": "integer",
            "description": "The total cost of the order.",
            "format": "int32",
            "example": 20
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the order total is represented.",
            "example": "USD"
          },
          "placed_at": {
            "type": "string",
            "description": "The date and time when the order was placed.",
            "example": "2023-10-05T10:00:00Z"
          },
          "estimated_delivery": {
            "type": "string",
            "description": "The estimated delivery date for the order.",
            "example": "2023-10-10"
          }
        },
        "description": "Details pertaining to a created order."
