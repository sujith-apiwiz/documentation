        "title": "Order Request Body",
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "The unique identifier of the user placing the order.",
            "format": "int32",
            "example": 1006
          },
          "items": {
            "type": "array",
            "description": "A list of items included in the order.",
            "example": [
              {
                "sku": "COF-4120",
                "qty": 3
              }
            ],
