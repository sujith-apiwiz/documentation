      "MICROSERVICE_PRODUCTION_createHospitalAppointment-CreateHospitalAppointmentResponse_200": {
        "title": "Hospital Appointment Policy Response",
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "description": "Identifier for the insurance policy associated with the appointment.",
            "example": "POL-100001"
          },
          "customerId": {
            "type": "string",
            "description": "Identifier for the customer making the appointment.",
            "example": "INS-10001"
          },
          "policyType": {
            "type": "string",
            "description": "Type of insurance policy (e.g., health, dental).",
            "example": "HEALTH"
          },
          "coverageAmount": {
            "type": "integer",
            "description": "Total amount of coverage provided by the insurance policy.",
            "format": "int32",
            "example": 500000
          },
          "premiumAmount": {
            "type": "integer",
            "description": "Monthly premium amount for the insurance policy.",
            "format": "int32",
            "example": 12000
          },
          "status": {
            "type": "string",
            "description": "Current status of the policy (e.g., active, expired).",
            "example": "ACTIVE"
          },
          "startDate": {
            "type": "string",
            "description": "Start date of the policy coverage.",
            "example": "2026-07-16"
          },
          "endDate": {
            "type": "string",
            "description": "End date of the policy coverage.",
            "example": "2027-07-16"
          },
          "message": {
            "type": "string",
            "description": "Optional message related to the policy or appointment status.",
            "example": "Insurance policy created successfully."
          }
        },
        "description": "Response schema for a successful hospital appointment operation, detailing the associated policy and customer information.",
        "example": {
          "policyId": "POL-100001",
          "customerId": "INS-10001",
          "policyType": "HEALTH",
          "coverageAmount": 500000,
          "premiumAmount": 12000,
          "status": "ACTIVE",
          "startDate": "2026-07-16",
          "endDate": "2027-07-16",
          "message": "Insurance policy created successfully."
        }
      },
