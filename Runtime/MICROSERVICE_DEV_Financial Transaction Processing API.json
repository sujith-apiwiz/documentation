        "title": "Error Response for Transaction Operation",
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "The timestamp of when the error occurred.",
            "example": "2026-07-13T12:20:39Z"
          },
          "status": {
            "type": "boolean",
            "description": "Indicates whether the operation was successful or not.",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "The error code associated with the transaction failure.",
            "example": "INTERNAL_SERVER_ERROR"
          },
          "message": {
            "type": "string",
            "description": "A human-readable message providing more details about the error.",
            "example": "Unable to process financial transaction due to internal service failure."
          },
          "path": {
            "type": "string",
            "description": "The API path where the error occurred.",
            "example": "/v1/finance/transactions"
          },
          "trace": {
            "type": "string",
            "description": "Trace information for debugging purposes.",
            "example": "463e58cc-2786-45fa-8b64-4d32a8b554bc"
          },
          "details": {
            "$ref": "#/components/schemas/MICROSERVICE_DEV_createTransaction-ErrorDetails"
          },
          "suggestion": {
            "type": "string",
            "description": "Suggestions for resolving the error.",
            "example": "Please retry after some time or contact support if the issue persists."
          }
        },
        "description": "Schema representing the error response structure for transaction operations when a server-side error occurs.",
        "example": {
          "timestamp": "2026-07-13T12:20:39Z",
          "status": false,
          "error": "INTERNAL_SERVER_ERROR",
          "message": "Unable to process financial transaction due to internal service failure.",
