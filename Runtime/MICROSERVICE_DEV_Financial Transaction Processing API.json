          },
          "trace": {
            "type": "string",
            "description": "A stack trace of the error, useful for debugging.",
            "example": "463e58cc-2786-45fa-8b64-4d32a8b554bc"
          },
          "details": {
            "description": "Additional details about the error.",
            "$ref": "#/components/schemas/MICROSERVICE_DEV_createTransaction-ErrorDetails"
          },
          "suggestion": {
            "type": "string",
            "description": "Suggestions to resolve the error.",
            "example": "Verify account details and retry the transaction."
          }
        },
        "example": {
          "timestamp": "2026-07-13T12:20:39Z",
          "status": false,
          "error": "ACCOUNT_NOT_FOUND",
          "message": "Source account details not found for transaction processing.",
          "path": "/v1/finance/transactions",
          "trace": "463e58cc-2786-45fa-8b64-4d32a8b554bc",
          "details": {
            "accountNumber": "ACC-999999",
