            "example": "TXN-100001"
          },
          "customerId": {
            "type": "string",
            "description": "Unique identifier for the customer associated with the transaction.",
            "example": "FIN-10001"
          },
          "accountNumber": {
            "type": "string",
            "description": "Account number from which the transaction is made.",
            "example": "ACC-500001"
          },
          "transactionType": {
            "type": "string",
            "description": "Type of the transaction (e.g., deposit, withdrawal).",
            "example": "TRANSFER"
          },
          "amount": {
            "type": "string",
            "description": "Amount of money involved in the transaction.",
            "example": "****"
          },
          "currency": {
            "type": "string",
            "description": "Currency in which the transaction is conducted.",
            "example": "USD"
          },
          "status": {
            "type": "string",
            "description": "Current status of the transaction (e.g., pending, completed).",
            "example": "SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "Additional message or notes regarding the transaction.",
            "example": "Transaction processed successfully."
          }
        },
        "description": "Represents the response for a successful transaction operation.",
        "example": {
          "transactionId": "TXN-100001",
          "customerId": "FIN-10001",
          "accountNumber": "ACC-500001",
          "transactionType": "TRANSFER",
          "amount": "****",
          "currency": "USD",
          "status": "SUCCESS",
          "message": "Transaction processed successfully."
        }
      },
      "MICROSERVICE_DEV_createTransaction-CreateTransactionRequest": {
        "title": "Transaction Request Body",
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Unique identifier for the customer.",
            "example": "FIN-99999"
          },
          "accountNumber": {
            "type": "string",
            "description": "The account number from which the transaction will be made.",
            "example": "ACC-999999"
          },
          "transactionType": {
            "type": "string",
            "description": "Type of transaction (e.g., 'debit', 'credit').",
            "example": "TRANSFER"
          },
          "amount": {
            "type": "string",
            "description": "Total amount for the transaction.",
            "example": "****"
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the transaction (e.g., 'USD', 'EUR').",
            "example": "USD"
          },
          "beneficiaryAccount": {
            "type": "string",
            "description": "Account number of the beneficiary to receive the transaction.",
            "example": "ACC-800001"
          },
          "transactionDate": {
            "type": "string",
            "description": "Date of the transaction in ISO 8601 format.",
            "example": "2026-07-15"
          }
        },
        "description": "Schema representing the request body for initiating a transaction operation.",
        "example": {
          "customerId": "FIN-99999",
          "accountNumber": "ACC-999999",
          "transactionType": "TRANSFER",
          "amount": "****",
          "currency": "USD",
          "beneficiaryAccount": "ACC-800001",
          "transactionDate": "2026-07-15"
        }
      },
      "MICROSERVICE_DEV_createTransaction-CreateTransactionResponse_404": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "The time at which the error occurred, formatted as a string.",
