            "type": "string",
            "description": "Unique identifier for the redemption request.",
            "example": "60f3a517-7cca-458a-9e1c-3f036dd9382b"
          },
          "referenceNumber": {
            "type": "string",
            "description": "Reference number associated with the redemption.",
            "example": "LOYALTY-10622"
