          "customer": {
            "description": "Information about the customer requesting the redemption.",
            "$ref": "#/components/schemas/Customer"
          },
          "resource": {
            "type": "string",
            "description": "Resource type related to the redemption.",
            "example": "loyalty/redeem"
          },
          "priority": {
            "type": "integer",
            "description": "Priority level of the redemption request.",
            "format": "int32",
            "example": 1
          },
          "amount": {
            "type": "number",
