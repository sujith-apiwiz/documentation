            "example": true
          },
          "requestedAt": {
            "type": "string",
            "description": "Timestamp of when the redemption was requested.",
            "example": "2026-01-03T06:35:41+00:00"
          },
          "channel": {
            "type": "string",
            "description": "Channel through which the redemption was made.",
            "example": "CALL_CENTER"
          },
          "recordIndex": {
            "type": "integer",
            "description": "Index of the record associated with the redemption.",
            "format": "int32",
            "example": 622
          }
        },
        "description": "Schema for a request body to redeem loyalty points in the loyalty system.",
        "example": {
          "requestId": "60f3a517-7cca-458a-9e1c-3f036dd9382b",
          "referenceNumber": "LOYALTY-10622",
          "customer": {
            "firstName": "Chris",
            "lastName": "Brown",
            "email": "chris.brown276@example.com",
            "vipCustomer": false,
            "customerAge": 57
          },
          "resource": "loyalty/redeem",
          "priority": 1,
          "amount": 1091.44,
          "currency": "USD",
          "notificationRequired": true,
