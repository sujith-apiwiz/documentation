            "example": "DIWALI3014"
          },
          "discountPercent": {
            "type": "integer",
            "description": "Percentage discount offered by the coupon (0-100).",
            "format": "int32",
            "example": 15
          },
          "validUntil": {
            "type": "string",
            "description": "The expiration date of the coupon in ISO 8601 format.",
            "example": "2026-11-27"
          }
        },
