            "format": "int32",
            "example": 1
          },
          "startDate": {
            "type": "string",
            "description": "The start date of the booking in ISO 8601 format.",
            "example": "2026-09-20T19:26:42.577Z"
          },
          "endDate": {
            "type": "string",
            "description": "The end date of the booking in ISO 8601 format.",
            "example": "2026-10-19T10:19:55.980Z"
          },
          "totalAmount": {
            "type": "number",
            "description": "The total amount for the booking.",
            "example": 5695.13
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the total amount is represented.",
            "example": "GBP"
          }
        },
        "description": "Schema representing the request body for creating a new booking.",
