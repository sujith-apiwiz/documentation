  "openapi": "3.0.1",
  "info": {
    "title": "MICROSERVICE_DEV_SIM Swap Management API",
    "description": "The SIM Swap Management API enables telecommunications service providers to efficiently manage SIM swap requests for their customers. This endpoint allows users to initiate the process of swapping SIM cards associated with their accounts, ensuring seamless access to mobile services without interruptions. Typical consumers of this API include customer support teams and automated systems that handle customer requests related to SIM changes. By streamlining SIM swaps, the API enhances customer satisfaction and reduces potential downtime.",
    "version": "1.0"
  },
