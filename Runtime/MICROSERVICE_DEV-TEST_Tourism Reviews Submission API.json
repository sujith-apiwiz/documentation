            "example": "REV-546750"
          },
          "touristId": {
            "type": "string",
            "description": "The unique identifier of the tourist who is submitting the review.",
            "example": "TUR-53853"
          },
          "attractionId": {
            "type": "string",
            "description": "The unique identifier of the attraction being reviewed.",
            "example": "ATT-2273"
          },
          "rating": {
            "type": "integer",
            "description": "The rating given by the tourist, typically from 1 to 5.",
            "format": "int32",
            "example": 5
          },
          "comment": {
            "type": "string",
            "description": "The text of the review comment provided by the tourist.",
            "example": "Beautiful views"
          }
        },
