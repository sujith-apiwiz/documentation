        "title": "Cart Item Request",
        "required": [
          "qty",
          "sku"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The stock keeping unit (SKU) identifier for the item.",
            "example": "BAG-5518"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the item to add to the cart.",
            "format": "int32",
            "example": 3
          }
        },
        "description": "Schema for the request body when adding items to a cart.",
        "example": {
          "sku": "BAG-5518",
          "qty": 3
        }
      },
      "CreateApiCartItemResponse_200": {
        "title": "Cart Response",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status of the cart operation.",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/CartData"
          }
        },
        "description": "Response object containing the status and cart data after operations related to items in a cart.",
        "example": {
          "status": "success",
          "data": {
            "cartId": "CRT-107513",
            "userId": 1002,
            "items": [
              {
                "sku": "BAG-5518",
                "name": "Wildcraft 35L Laptop Backpack",
                "qty": 2,
                "unitPrice": 2199,
                "lineTotal": 4398
              }
            ],
            "subtotal": 4398,
            "currency": "INR",
            "updatedAt": "2026-10-23T07:20:09.665342Z",
            "added": {
              "sku": "BAG-5518",
              "qty": 3
            }
          },
          "requestId": "req_mg2t8sjf77sr"
        }
      },
      "CartData": {
        "title": "Cart Data",
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "description": "Unique identifier for the cart.",
            "example": "CRT-123456"
          },
          "userId": {
            "type": "integer",
            "description": "Identifier for the user who owns the cart.",
            "format": "int32",
            "example": 1
          },
          "items": {
            "type": "array",
            "description": "List of items in the cart.",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "subtotal": {
            "type": "integer",
            "description": "Total cost of the items in the cart before taxes and discounts.",
            "format": "int32",
            "example": 100
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the cart's subtotal.",
            "example": "USD"
          },
          "updatedAt": {
            "type": "string",
            "description": "The date and time when the cart was last updated.",
            "example": "2023-10-01T12:00:00Z"
          },
          "added": {
            "$ref": "#/components/schemas/AddedItem"
          },
          "requestId": {
            "type": "string",
            "description": "Unique identifier for the request.",
            "example": "REQ-654321"
          }
        },
        "description": "Detailed information about the contents of the cart."
      },
      "CartItem": {
        "title": "Cart Item",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock Keeping Unit identifier for the item.",
            "example": "ITEM-001"
          },
          "name": {
            "type": "string",
            "description": "Name of the item.",
            "example": "Sample Item"
          },
          "qty": {
            "type": "integer",
            "description": "Quantity of the item in the cart.",
            "format": "int32",
            "example": 1
          },
          "unitPrice": {
            "type": "integer",
            "description": "Price per unit of the item.",
            "format": "int32",
            "example": 50
          },
          "lineTotal": {
            "type": "integer",
            "description": "Total price of the item based on quantity.",
            "format": "int32",
            "example": 50
          }
        },
        "description": "Details of a single item in the cart."
      },
      "AddedItem": {
        "title": "Added Item",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock Keeping Unit identifier for the item added to the cart.",
            "example": "ITEM-001"
          },
          "qty": {
            "type": "integer",
            "description": "Quantity of the item that was added to the cart.",
            "format": "int32",
            "example": 3
          }
        },
        "description": "Details of an item that was added to the cart."
      }
