      "MICROSERVICE_DEV_createTicket-CreateTicketRequest": {
        "title": "Ticket Request",
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "Unique identifier for the ticket.",
            "example": "BT-154706"
          },
          "busId": {
            "type": "string",
            "description": "Unique identifier for the bus associated with the ticket.",
            "example": "BUS-1160"
          },
          "routeId": {
            "type": "string",
            "description": "Unique identifier for the route associated with the ticket.",
            "example": "RT-498"
          },
          "passengerName": {
            "type": "string",
            "description": "Name of the passenger for whom the ticket is booked.",
            "example": "Jane Muller"
          },
          "seatNumber": {
            "type": "integer",
            "description": "Assigned seat number for the passenger.",
            "format": "int32",
            "example": 20
          },
          "origin": {
            "type": "string",
            "description": "Origin location of the travel.",
            "example": "West Depot"
          },
          "destination": {
            "type": "string",
            "description": "Destination location of the travel.",
            "example": "South Station"
          },
          "fare": {
            "type": "number",
            "description": "The fare for booking the ticket.",
            "example": 34.37
          },
          "departureTime": {
            "type": "string",
            "description": "Scheduled departure time for the bus.",
            "example": "2026-07-25T16:20:02.509Z"
          }
        },
        "description": "Schema representing a request to create a new ticket.",
        "example": {
          "ticketId": "BT-154706",
          "busId": "BUS-1160",
          "routeId": "RT-498",
          "passengerName": "Jane Muller",
          "seatNumber": 20,
          "origin": "West Depot",
          "destination": "South Station",
          "fare": 34.37,
          "departureTime": "2026-07-25T16:20:02.509Z"
        }
