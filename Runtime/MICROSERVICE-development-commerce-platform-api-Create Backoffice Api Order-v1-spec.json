                    "Sku": "SHO-3307",
                    "Name": "Nike Revolution 7 Running Shoes",
                    "Qty": 1,
                    "UnitPrice": 3995,
                    "LineTotal": 3995
                  }
                ],
                "Total": 3995,
                "Currency": "INR",
                "PlacedAt": "2026-10-23T07:20:08.141583Z",
                "EstimatedDelivery": "2026-10-27"
              }
            }
          },
          "example": {}
