              "Sku": "SHO-3307",
              "Qty": 1
            }
          ],
          "Total": 3995
        }
      },
      "OrderItem": {
        "title": "Order Item",
        "type": "object",
        "properties": {
          "Sku": {
            "type": "string",
            "description": "Stock Keeping Unit identifier for the item.",
            "example": "item-001"
          },
          "Name": {
            "type": "string",
            "description": "Name or description of the item.",
            "example": "Sample Item"
          },
          "Qty": {
            "type": "integer",
            "description": "Quantity of the item ordered.",
            "format": "int32",
            "example": 2
          },
          "UnitPrice": {
            "type": "integer",
            "description": "Price per unit of the item.",
            "format": "int32",
            "example": 100
          },
          "LineTotal": {
            "type": "integer",
            "description": "Total cost for the item (Quantity * Unit Price).",
            "format": "int32",
            "example": 200
          }
        },
        "description": "Represents a single item in an order."
      },
      "CreateBackofficeApiOrderResponse_200": {
        "title": "Order Response",
        "type": "object",
