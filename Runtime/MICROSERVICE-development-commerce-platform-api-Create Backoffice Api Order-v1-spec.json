                    "type": "string",
                    "description": "Unique identifier for the order.",
                    "example": "order-123456"
                  },
                  "UserId": {
                    "type": "integer",
                    "description": "The ID of the user who placed the order.",
                    "format": "int32",
                    "example": 1
                  },
                  "Status": {
                    "type": "string",
                    "description": "Current status of the order.",
                    "example": "Processing"
                  },
                  "Items": {
                    "type": "array",
                    "description": "List of items included in the order.",
                    "example": [
                      {
                        "Sku": "item-001",
                        "Name": "Sample Item",
                        "Qty": 2,
                        "UnitPrice": 100,
                        "LineTotal": 200
                      }
                    ],
                    "items": {
                      "$ref": "#/components/schemas/OrderItem"
                    }
                  },
                  "Total": {
                    "type": "integer",
                    "description": "Total amount for the order.",
                    "format": "int32",
                    "example": 250
                  },
                  "Currency": {
                    "type": "string",
                    "description": "Currency used for the order amount.",
                    "example": "USD"
                  },
                  "PlacedAt": {
                    "type": "string",
                    "description": "Timestamp when the order was placed.",
                    "example": "2023-10-01T12:00:00Z"
                  },
                  "EstimatedDelivery": {
                    "type": "string",
                    "description": "Estimated delivery date for the order.",
                    "example": "2023-10-05T12:00:00Z"
                  }
                },
                "description": "The main body of the response containing order details.",
                "example": {
                  "OrderId": "order-123456",
                  "UserId": 1,
                  "Status": "Processing",
                  "Items": [
                    {
                      "Sku": "item-001",
                      "Name": "Sample Item",
                      "Qty": 2,
                      "UnitPrice": 100,
                      "LineTotal": 200
                    }
                  ],
                  "Total": 250,
                  "Currency": "USD",
                  "PlacedAt": "2023-10-01T12:00:00Z",
                  "EstimatedDelivery": "2023-10-05T12:00:00Z"
                }
              },
              "example": {}
            },
            "description": "Detailed response information.",
            "example": {
              "Api": "createOrder",
              "Region": "ap-south-1",
              "RequestId": "req_dsjwg6un9vw9",
              "Body": {
                "OrderId": "ORD-93749",
                "UserId": 1006,
                "Status": "CONFIRMED",
                "Items": [
