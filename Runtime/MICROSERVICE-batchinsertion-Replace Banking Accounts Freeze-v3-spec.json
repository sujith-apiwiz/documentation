          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "A request to freeze a specified account, preventing any further transactions until unfreezing is requested. This operation is typically used in cases of suspected fraud or account compromise.",
