        "description": "Data object containing details about shipment rates between two postal codes.",
        "example": {
          "fromPostalCode": "12345",
          "toPostalCode": "54321",
          "weightKg": 10,
          "quotes": [
            {
              "carrier": "Carrier A",
              "service": "Standard",
              "price": 1500,
              "currency": "USD",
              "etaDays": 5
