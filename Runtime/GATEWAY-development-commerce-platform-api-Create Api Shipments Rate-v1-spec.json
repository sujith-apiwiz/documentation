            "format": "int32",
            "example": 1500
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the price is denoted.",
            "example": "USD"
          },
          "etaDays": {
            "type": "integer",
            "description": "Estimated time of arrival in days.",
            "format": "int32",
            "example": 5
          }
        },
        "description": "A quote for shipping provided by a carrier."
