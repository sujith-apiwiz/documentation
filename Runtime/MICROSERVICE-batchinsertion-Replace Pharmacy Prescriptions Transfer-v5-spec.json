  "paths": {
    "/pharmacy/v5/prescriptions/transfer": {
      "put": {
        "tags": [
          "Prescription Management"
        ],
        "summary": "Transfer a prescription to another pharmacy.",
        "description": "This endpoint allows users to transfer their prescription from one pharmacy to another, ensuring continuity of medication management. The request must include the details of the prescription and the new pharmacy information.",
        "operationId": "replacePharmacyPrescriptionsTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Request body for transferring a prescription. This should contain all necessary details required to complete the transfer process, including patient information, prescription details, and the destination pharmacy.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplacePharmacyPrescriptionsTransferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request completed successfully. The transfer of the prescription is confirmed.",
            "headers": {
              "x-processing-time": {
                "$ref": "#/components/headers/x-processing-time"
              }
            },
            "content": {
              "application/json": {
                "schema": {
