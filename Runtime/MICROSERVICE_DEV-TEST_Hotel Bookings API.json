      "MICROSERVICE_DEV-TEST_createBooking-CreateBookingRequest": {
        "title": "BookingRequest",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "description": "Unique identifier for the booking.",
            "example": "HB-517930"
          },
          "hotelId": {
            "type": "string",
            "description": "Identifier for the hotel where the booking is made.",
            "example": "HTL-3348"
          },
          "guestName": {
            "type": "string",
            "description": "Name of the guest making the booking.",
            "example": "Wei Garcia"
          },
          "roomType": {
            "type": "string",
            "description": "Type of room booked.",
            "example": "DELUXE"
          },
          "checkInDate": {
            "type": "string",
            "description": "Check-in date for the booking in ISO 8601 format.",
            "example": "2026-08-25T21:24:46.328Z"
          },
          "checkOutDate": {
            "type": "string",
            "description": "Check-out date for the booking in ISO 8601 format.",
            "example": "2026-07-20T17:38:45.314Z"
          },
          "guests": {
            "type": "integer",
            "description": "Number of guests included in the booking.",
            "format": "int32",
            "example": 2
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount for the booking.",
            "example": 1541.03
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the total amount.",
            "example": "USD"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Current payment status of the booking.",
            "example": "PENDING"
          }
        },
        "description": "Schema representing the request body for creating a new booking.",
        "example": {
          "bookingId": "HB-517930",
          "hotelId": "HTL-3348",
          "guestName": "Wei Garcia",
          "roomType": "DELUXE",
          "checkInDate": "2026-08-25T21:24:46.328Z",
          "checkOutDate": "2026-07-20T17:38:45.314Z",
          "guests": 2,
          "totalAmount": 1541.03,
          "currency": "USD",
          "paymentStatus": "PENDING"
        }
      },
