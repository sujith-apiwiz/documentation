      "MICROSERVICE_DEV-TEST_createBooking-CreateBookingRequest": {
        "title": "Booking Request",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "description": "Unique identifier for the booking.",
            "example": "HB-100809"
          },
          "hotelId": {
            "type": "string",
            "description": "Unique identifier for the hotel being booked.",
            "example": "HTL-6902"
          },
          "guestName": {
            "type": "string",
            "description": "Name of the guest making the booking.",
            "example": "Priya Kumar"
          },
          "roomType": {
            "type": "string",
            "description": "Type of room being booked (e.g., single, double, suite).",
            "example": "DOUBLE"
          },
          "checkInDate": {
            "type": "string",
            "description": "Check-in date for the booking in ISO 8601 format.",
            "example": "2026-08-01T07:21:16.843Z"
          },
          "checkOutDate": {
            "type": "string",
            "description": "Check-out date for the booking in ISO 8601 format.",
            "example": "2026-07-26T02:21:07.204Z"
          },
          "guests": {
            "type": "integer",
            "description": "Number of guests included in the booking.",
            "format": "int32",
            "example": 1
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount for the booking in the specified currency.",
            "example": 411.19
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the total amount (e.g., USD, EUR).",
            "example": "USD"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Current payment status of the booking (e.g., pending, completed).",
            "example": "PAID"
          }
        },
        "description": "Schema representing the request body for creating a new booking.",
        "example": {
          "bookingId": "HB-100809",
          "hotelId": "HTL-6902",
          "guestName": "Priya Kumar",
          "roomType": "DOUBLE",
          "checkInDate": "2026-08-01T07:21:16.843Z",
          "checkOutDate": "2026-07-26T02:21:07.204Z",
          "guests": 1,
          "totalAmount": 411.19,
          "currency": "USD",
          "paymentStatus": "PAID"
        }
