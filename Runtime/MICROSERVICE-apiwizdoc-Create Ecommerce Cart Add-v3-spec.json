      "post": {
        "tags": [
          "Shopping Cart"
        ],
        "summary": "Add an item to the shopping cart.",
        "description": "This endpoint allows users to add a specified item to their shopping cart. It requires identifying which item to add and handles necessary updates to the cart's total value and item count.",
        "operationId": "createEcommerceCartAdd",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Adds an item to the shopping cart. The request should include the item details and any necessary attributes for the cart operation.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEcommerceCartAddRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The item was successfully added to the cart.",
            "headers": {
