        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The coupon code that was validated.",
            "example": "SUMMER2023"
          },
          "valid": {
            "type": "boolean",
            "description": "Indicates whether the coupon is valid.",
            "example": false
          },
          "cartTotal": {
            "type": "integer",
