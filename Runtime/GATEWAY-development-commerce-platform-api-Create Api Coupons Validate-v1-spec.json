            "example": 150
          },
          "discountAmount": {
            "type": "integer",
            "description": "Amount discounted from the cart total due to the coupon.",
            "format": "int32",
            "example": 20
          },
          "payable": {
            "type": "integer",
            "description": "Total amount to be paid after the discount is applied.",
            "format": "int32",
            "example": 130
          },
          "message": {
            "type": "string",
            "description": "Additional message regarding the coupon validation.",
