        "title": "Laptop Request Body",
        "type": "object",
        "properties": {
          "lawsonit_laptop_id": {
            "type": "integer",
            "description": "The unique identifier for the Lawson IT laptop.",
            "format": "int32",
            "example": 0
          },
          "requestedBy": {
            "type": "string",
            "description": "The name of the person requesting the laptop.",
            "example": "John Doe"
          },
          "quantity": {
            "type": "integer",
            "description": "The number of laptops being requested.",
            "format": "int32",
            "example": 1
          },
          "isPriority": {
            "type": "boolean",
            "description": "Indicates if the request is a priority request.",
            "example": false
          },
          "unitPrice": {
            "type": "number",
            "description": "The price per unit of the laptop.",
            "example": 1299.99
          },
          "dimensions": {
            "$ref": "#/components/schemas/LaptopDimensions"
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "warehouseCodes": {
            "type": "array",
            "description": "List of warehouse codes where the laptops will be stored.",
            "items": {
              "type": "integer",
              "format": "int32",
              "example": 101
            }
          }
        },
        "description": "Schema representing the request body for creating a Lawson IT laptop request.",
        "example": {
          "lawsonit_laptop_id": 123,
          "requestedBy": "John Doe",
          "quantity": 1,
          "isPriority": true,
          "unitPrice": 1299.99,
          "dimensions": {
            "width": 15,
            "height": 10,
            "unit": "inches"
          },
          "supplier": {
            "name": "Best Supplier Inc.",
            "verified": true,
            "contact": {
              "email": "contact@bestsupplier.com",
              "phone": 1234567890
            }
          },
          "warehouseCodes": [
            101,
            102
          ]
        }
      },
