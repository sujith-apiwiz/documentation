      "put": {
        "tags": [
          "Points Management"
        ],
        "summary": "Transfer points from one user to another.",
        "description": "This endpoint allows users to transfer points to another user. It requires the sender's and recipient's details as well as the amount of points to be transferred. Ensure sufficient points are available before proceeding with the transfer.",
