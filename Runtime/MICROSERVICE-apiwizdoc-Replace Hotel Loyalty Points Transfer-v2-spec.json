          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Request body for transferring points between users. The body should contain the necessary details such as the sender's user ID, recipient's user ID, and the number of points to be transferred. Ensure that the user IDs correspond to valid accounts and that the sender has sufficient points for the transaction.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceHotelLoyaltyPointsTransferRequest"
              }
            }
          }
        },
