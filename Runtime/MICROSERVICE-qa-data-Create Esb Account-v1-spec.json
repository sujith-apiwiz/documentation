            "description": "The currency in which the transaction is made.",
            "example": "USD"
          },
          "reference": {
            "type": "string",
            "description": "An optional reference for the transaction.",
            "example": "Invoice-8831"
          },
          "channel": {
            "type": "string",
            "description": "The channel through which the transaction is initiated.",
            "example": "MOBILE_APP"
          },
          "createdAt": {
            "type": "number",
            "description": "Timestamp indicating when the transaction was created.",
            "example": 1790144527912
