      "MICROSERVICE_TEST-DEV_createBooking-CreateBookingRequest": {
        "title": "Booking Request Body",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "description": "The unique identifier for the booking.",
            "example": "TB-673836"
          },
          "touristId": {
            "type": "string",
            "description": "The unique identifier for the tourist making the booking.",
            "example": "TUR-52339"
          },
          "destination": {
            "type": "string",
            "description": "The destination for the booking.",
            "example": "Paris"
          },
          "packageName": {
            "type": "string",
            "description": "The name of the travel package booked.",
            "example": "City Highlights"
          },
          "travelers": {
            "type": "integer",
            "description": "The number of travelers included in the booking.",
            "format": "int32",
            "example": 4
          },
          "startDate": {
            "type": "string",
            "description": "The start date of the booking in ISO 8601 format.",
            "example": "2026-08-17T03:01:13.256Z"
          },
          "endDate": {
            "type": "string",
            "description": "The end date of the booking in ISO 8601 format.",
            "example": "2026-06-07T06:36:32.394Z"
          },
          "totalAmount": {
            "type": "number",
            "description": "The total amount for the booking in the specified currency.",
            "example": 5262.85
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the total amount is denominated.",
            "example": "EUR"
          }
        },
        "description": "Schema representing the request body for creating a new booking.",
        "example": {
          "bookingId": "TB-673836",
          "touristId": "TUR-52339",
          "destination": "Paris",
          "packageName": "City Highlights",
          "travelers": 4,
          "startDate": "2026-08-17T03:01:13.256Z",
          "endDate": "2026-06-07T06:36:32.394Z",
          "totalAmount": 5262.85,
          "currency": "EUR"
