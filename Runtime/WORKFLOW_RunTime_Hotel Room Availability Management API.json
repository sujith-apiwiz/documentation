  "info": {
    "title": "WORKFLOW_RunTime_Hotel Room Availability Management API",
    "description": "This API enables users to manage and check the availability of hotel rooms in real time. Through seamless interactions, businesses can offer accurate room availability to their customers, enhancing the booking experience. This API is particularly useful for hotels, travel agencies, and booking platforms that require current information on room status. Typical use cases include integrating availability checks into booking systems and managing room inventory efficiently.",
    "version": "1.0"
  },
