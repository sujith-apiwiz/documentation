            "type": "string",
            "description": "Name of the passenger who bought the ticket.",
            "example": "Liam Rossi"
          },
          "seatNumber": {
            "type": "integer",
            "description": "The seat number assigned to the passenger.",
            "format": "int32",
            "example": 47
          },
          "origin": {
            "type": "string",
            "description": "The starting point of the bus journey.",
            "example": "Airport Hub"
          },
          "destination": {
            "type": "string",
            "description": "The end point of the bus journey.",
            "example": "Downtown"
          },
          "fare": {
            "type": "number",
            "description": "The cost of the ticket.",
            "example": 39.46
          },
          "departureTime": {
            "type": "string",
            "description": "The scheduled departure time of the bus.",
            "example": "2026-08-01T18:20:27.726Z"
          }
        },
        "description": "Schema representing the details required to create a bus ticket.",
        "example": {
          "ticketId": "BT-655141",
          "busId": "BUS-8979",
          "routeId": "RT-718",
          "passengerName": "Liam Rossi",
          "seatNumber": 47,
          "origin": "Airport Hub",
          "destination": "Downtown",
