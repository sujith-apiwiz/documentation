      "MICROSERVICE_DEV-TEST_createTicketV1-CreateTicketV1Request": {
        "title": "Ticket Creation Request",
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "description": "Unique identifier for the ticket.",
            "example": "BT-655141"
          },
          "busId": {
            "type": "string",
            "description": "Identifier for the bus associated with the ticket.",
            "example": "BUS-8979"
          },
