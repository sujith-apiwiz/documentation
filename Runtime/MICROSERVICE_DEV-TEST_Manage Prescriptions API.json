      "MICROSERVICE_DEV-TEST_createPrescription-CreatePrescriptionRequest": {
        "title": "Create Prescription Request",
        "type": "object",
        "properties": {
          "prescriptionId": {
            "type": "string",
            "description": "Unique identifier for the prescription.",
            "example": "RX-526786"
          },
          "patientId": {
            "type": "string",
            "description": "Unique identifier of the patient for whom the prescription is issued.",
            "example": "PAT-807352"
          },
          "medication": {
            "type": "string",
            "description": "Name of the medication prescribed.",
            "example": "Lisinopril"
          },
          "dosage": {
            "type": "string",
            "description": "Dosage of the medication prescribed.",
            "example": "500mg"
          },
          "frequency": {
            "type": "string",
            "description": "Frequency at which the medication should be taken.",
            "example": "Once daily"
          },
          "prescribedBy": {
            "type": "string",
            "description": "Identifier or name of the healthcare professional who prescribed the medication.",
            "example": "DOC-6934"
          },
          "issuedDate": {
            "type": "string",
            "description": "Date when the prescription was issued.",
            "example": "2026-07-19T02:39:49.221Z"
          }
        },
        "description": "Schema representing the request body for creating a new prescription.",
        "example": {
          "prescriptionId": "RX-526786",
          "patientId": "PAT-807352",
          "medication": "Lisinopril",
          "dosage": "500mg",
          "frequency": "Once daily",
          "prescribedBy": "DOC-6934",
          "issuedDate": "2026-07-19T02:39:49.221Z"
        }
