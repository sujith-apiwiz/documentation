        "title": "Create Order Request",
        "required": [
          "items",
          "total",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "description": "The unique identifier of the user placing the order.",
            "format": "int32",
            "example": 1003
          },
          "items": {
            "type": "array",
            "description": "A list of items included in the order.",
            "example": [
              {
