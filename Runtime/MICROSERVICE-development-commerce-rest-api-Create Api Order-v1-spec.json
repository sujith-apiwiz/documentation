            }
          },
          "total": {
            "type": "integer",
            "description": "Total amount for the order.",
            "format": "int32",
            "example": 147970
          },
          "currency": {
            "type": "string",
            "description": "Currency used for the order total (e.g., 'USD', 'EUR').",
            "example": "INR"
          },
          "placedAt": {
            "type": "string",
            "description": "Timestamp indicating when the order was placed.",
            "example": "2026-10-28T16:20:06.515428Z"
          },
          "estimatedDelivery": {
            "type": "string",
            "description": "Estimated delivery date for the order.",
            "example": "2026-11-01"
          }
        },
        "description": "Response schema for an order creation operation, containing details about the order including items, total cost, and delivery information.",
        "example": {
          "orderId": "ORD-91171",
          "userId": 1003,
          "status": "CONFIRMED",
          "items": [
            {
              "sku": "LAP-1042",
              "name": "Lenovo ThinkPad E14 Gen 5",
