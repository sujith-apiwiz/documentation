            "description": "Current status of the order (e.g., 'Pending', 'Shipped', 'Delivered').",
            "example": "CONFIRMED"
          },
          "items": {
            "type": "array",
            "description": "List of items included in the order.",
            "example": [
              {
                "sku": "LAP-1042",
                "name": "Lenovo ThinkPad E14 Gen 5",
                "qty": 2,
                "unitPrice": 58990,
                "lineTotal": 117980
              },
              {
                "sku": "AUD-2210",
                "name": "Sony WH-1000XM5 Wireless Headphones",
                "qty": 1,
                "unitPrice": 29990,
                "lineTotal": 29990
              }
            ],
            "items": {
