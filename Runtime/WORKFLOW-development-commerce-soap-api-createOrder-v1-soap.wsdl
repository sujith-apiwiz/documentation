                        <xsd:element minOccurs="1" name="placedAt" type="xsd:string"><xsd:annotation><xsd:documentation>This field provides the timestamp when the order was placed.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="estimatedDelivery" type="xsd:string"><xsd:annotation><xsd:documentation>This field contains the estimated delivery date for the order.</xsd:documentation></xsd:annotation></xsd:element>
