        "example": {
          "status": "success",
          "data": {
            "shipmentId": "SHP-482996",
            "orderId": "ORD-75294",
            "carrier": "Blue Dart",
            "trackingNumber": "DT7097391002",
            "status": "LABEL_CREATED",
            "origin": "New Delhi",
            "createdAt": "2026-10-27T08:02:38.909292Z",
            "estimatedDelivery": "2026-10-30",
            "destination": {
              "name": "Mei Lin Chen",
              "line1": "21 Banjara Hills",
              "city": "Hyderabad",
              "postalCode": "500001",
              "country": "IN"
            }
          },
          "requestId": "req_wr9wwzzh781g"
        }
      },
