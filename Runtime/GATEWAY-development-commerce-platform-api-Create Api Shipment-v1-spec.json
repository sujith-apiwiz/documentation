        "title": "Shipment Request Body",
        "required": [
          "address",
          "carrier",
          "orderId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the order associated with the shipment.",
            "example": "ORD-75294"
          },
          "carrier": {
            "type": "string",
            "description": "The name of the carrier responsible for the shipment.",
            "example": "Blue Dart"
          },
          "address": {
            "description": "The destination address for the shipment.",
            "$ref": "#/components/schemas/ShippingAddress"
          }
        },
        "description": "Schema representing the request body for creating a shipment.",
        "example": {
          "orderId": "ORD-75294",
          "carrier": "Blue Dart",
          "address": {
            "name": "Mei Lin Chen",
            "line1": "21 Banjara Hills",
            "city": "Hyderabad",
            "postalCode": "500001",
            "country": "IN"
          }
        }
      },
      "ShippingAddress": {
        "title": "Shipping Address",
        "required": [
          "city",
          "country",
          "line1",
          "name",
          "postalCode"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the recipient.",
            "example": "John Doe"
          },
          "line1": {
            "type": "string",
            "description": "The first line of the street address.",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "description": "The city of the shipping address.",
            "example": "Springfield"
          },
          "postalCode": {
            "type": "string",
            "description": "The postal code of the shipping address.",
            "example": "12345"
          },
          "country": {
            "type": "string",
            "description": "The country of the shipping address.",
            "example": "USA"
          }
        },
        "description": "Schema representing a shipping address."
      },
      "CreateApiShipmentResponse_200": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status of the response, indicating whether the operation was successful or not.",
            "example": "success"
          },
          "data": {
            "type": "object",
            "description": "Contains the details of the shipment that was created.",
            "$ref": "#/components/schemas/ShipmentData"
          },
          "requestId": {
            "type": "string",
            "description": "An identifier for the request, used for tracking purposes.",
            "example": "req_wr9wwzzh781g"
