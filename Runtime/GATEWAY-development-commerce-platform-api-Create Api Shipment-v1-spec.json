          },
          "postalCode": {
            "type": "string",
            "description": "Postal code for the destination.",
            "example": "12345"
          },
          "country": {
            "type": "string",
            "description": "Country of the destination address.",
            "example": "USA"
          }
        },
        "description": "Address information of the shipment destination."
