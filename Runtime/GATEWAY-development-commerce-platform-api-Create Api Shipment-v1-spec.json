        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "description": "Unique identifier for the shipment.",
            "example": "sh_123456"
          },
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the associated order.",
            "example": "ord_123456"
          },
          "carrier": {
