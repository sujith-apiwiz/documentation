          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to obtain an access token by providing necessary credentials and authorization parameters. Ensure that the required fields are filled out correctly to receive the token successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "examples": {
                "example1": {
                  "value": {
                    "username": "user@example.com",
                    "password": "securepassword"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token request was successful and a token is returned.",
