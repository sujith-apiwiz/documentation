        ],
        "requestBody": {
          "description": "This request body is used to obtain a new access token. Please ensure that all required fields are provided correctly to receive a valid response.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "examples": {
                "example1": {
                  "value": {
                    "username": "user@example.com",
                    "password": "securepassword"
                  }
                }
              }
            }
          }
        },
