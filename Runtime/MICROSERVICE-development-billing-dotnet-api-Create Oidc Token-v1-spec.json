    "/oidc/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Generate a new authentication token.",
        "description": "This endpoint allows clients to generate a new authentication token, which is necessary for accessing protected resources. Ensure to provide valid credentials in the request body to obtain a successful response.",
        "operationId": "createOidcToken",
        "parameters": [
          {
            "$ref": "#/components/parameters/Host"
          },
          {
            "$ref": "#/components/parameters/Accept"
          },
          {
