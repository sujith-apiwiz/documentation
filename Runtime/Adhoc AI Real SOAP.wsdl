<?xml version="1.0" encoding="UTF-8" standalone="no"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:apiwiz="urn:apiwiz:wsdl" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://example.com/orders" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="AdhocAIRealSOAP" targetNamespace="http://example.com/orders"><wsdl:documentation>AdhocAIRealSOAP is designed to provide a seamless interface for users to query the status of their orders in real-time. The primary operation, GetOrder, allows consumers to retrieve comprehensive details about a specific order by providing its order ID. This service is typically utilized by businesses and consumers who are looking to track or manage their orders efficiently.</wsdl:documentation>
      
    <wsdl:types>
            
        <xsd:schema elementFormDefault="qualified" targetNamespace="http://example.com/orders">
            <xsd:element name="GetOrderRequest"><xsd:annotation><xsd:documentation>This element represents the request to retrieve order information and includes the necessary order ID.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="orderId" type="xsd:int"><xsd:annotation><xsd:documentation>This field contains the unique identifier of the order for which details are requested.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetOrderResponse"><xsd:annotation><xsd:documentation>This element provides the details of the order requested, including its status and total amount.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="orderId" type="xsd:int"><xsd:annotation><xsd:documentation>This field contains the unique identifier of the order.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="status" type="xsd:string"><xsd:annotation><xsd:documentation>This field indicates the current status of the order, such as pending or completed.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="total" type="xsd:decimal"><xsd:annotation><xsd:documentation>This field shows the total cost associated with the order.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetOrderFault"><xsd:annotation><xsd:documentation>This element is used to convey error information if the order retrieval process encounters a fault.</xsd:documentation></xsd:annotation>
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element minOccurs="1" name="faultcode" type="xsd:string"><xsd:annotation><xsd:documentation>This field specifies the error code that categorizes the fault.</xsd:documentation></xsd:annotation></xsd:element>
                        <xsd:element minOccurs="1" name="faultstring" type="xsd:string"><xsd:annotation><xsd:documentation>This field provides a textual description of the fault encountered.</xsd:documentation></xsd:annotation></xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
          
    </wsdl:types>
      
    <wsdl:message name="GetOrderFaultMessage"><wsdl:documentation>This message carries fault information in case of an error during the order retrieval process.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderFault" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:message name="GetOrderResponseMessage"><wsdl:documentation>This message contains the order details, including the order ID, status, and total amount, as a response to the GetOrder request.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderResponse" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:message name="GetOrderRequestMessage"><wsdl:documentation>This message carries the order ID that specifies which order details are being requested.</wsdl:documentation>
            
        <wsdl:part element="tns:GetOrderRequest" name="parameters">
    </wsdl:part>
          
    </wsdl:message>
      
    <wsdl:portType name="OrderServicePortType">
            
        <wsdl:operation name="GetOrder"><wsdl:documentation>This operation retrieves information about an order based on the provided order ID, allowing users to obtain details such as status and total cost.</wsdl:documentation>
                  
            <wsdl:input message="tns:GetOrderRequestMessage">
    </wsdl:input>
                  
            <wsdl:output message="tns:GetOrderResponseMessage">
    </wsdl:output>
                  
            <wsdl:fault message="tns:GetOrderFaultMessage" name="GetOrderFault">
    </wsdl:fault>
                
        </wsdl:operation>
          
    </wsdl:portType>
      
