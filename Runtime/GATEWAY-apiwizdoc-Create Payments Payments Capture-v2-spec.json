          },
          "notificationRequired": {
            "type": "boolean",
            "description": "Indicates whether a notification is required after the capture.",
            "example": true
          },
          "requestedAt": {
            "type": "string",
            "description": "Timestamp when the payment capture is requested.",
            "example": "2026-01-11T16:32:21+00:00"
          },
          "channel": {
            "type": "string",
            "description": "Channel through which the payment is being processed.",
            "example": "RETAIL_STORE"
          },
          "recordIndex": {
            "type": "integer",
            "description": "Index for record reference in the payment system.",
            "format": "int32",
            "example": 564
          }
        },
        "description": "Request body for capturing payments in the operation.",
        "example": {
          "requestId": "12bfb5da-52e2-42ef-9814-22f3dca1e6e7",
          "referenceNumber": "PAYMENTS-10564",
          "customer": {
            "firstName": "Mark",
            "lastName": "Jackson",
            "email": "mark.jackson791@example.com",
            "vipCustomer": false,
            "customerAge": 60
          },
          "resource": "payments/capture",
          "priority": 2,
          "amount": 1999.87,
          "currency": "EUR",
          "notificationRequired": true,
          "requestedAt": "2026-01-11T16:32:21+00:00",
          "channel": "RETAIL_STORE",
          "recordIndex": 564
        }
      },
