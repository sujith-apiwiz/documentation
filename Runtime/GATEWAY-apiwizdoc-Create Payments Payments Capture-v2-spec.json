          "currency",
          "customer",
          "referenceNumber",
          "requestId",
          "requestedAt",
          "resource"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique identifier for the payment capture request.",
            "example": "12bfb5da-52e2-42ef-9814-22f3dca1e6e7"
          },
          "referenceNumber": {
            "type": "string",
            "description": "Reference number associated with the payment.",
            "example": "PAYMENTS-10564"
          },
          "customer": {
            "description": "Details of the customer initiating the payment.",
            "$ref": "#/components/schemas/Customer"
          },
          "resource": {
            "type": "string",
            "description": "Resource identifier for the payment operation.",
            "example": "payments/capture"
          },
          "priority": {
            "type": "integer",
            "description": "Priority level for the payment request.",
            "format": "int32",
            "example": 2
          },
          "amount": {
            "type": "number",
            "description": "Amount to be captured for the payment.",
            "example": 1999.87
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the payment amount.",
