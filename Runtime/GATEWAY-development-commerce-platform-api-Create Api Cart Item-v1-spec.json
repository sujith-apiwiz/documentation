            "type": "string",
            "description": "A unique identifier for the request.",
            "example": "req_one2tl6p3gsy"
          }
        },
        "description": "Response object containing the status and data of cart operations.",
        "example": {
          "status": "success",
          "data": {
            "cartId": "CRT-131225",
            "userId": 1007,
            "items": [
              {
                "sku": "COF-4120",
