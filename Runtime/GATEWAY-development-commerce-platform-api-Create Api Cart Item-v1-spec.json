        "description": "An item in the shopping cart, including SKU, name, quantity, unit price, and line total."
      },
      "ItemAdded": {
        "title": "Item Added",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock keeping unit of the added item.",
            "example": "item-123"
          },
          "qty": {
            "type": "integer",
            "description": "Quantity of the added item.",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Details of the item added to the cart, including SKU and quantity."
      }
