      "CartData": {
        "title": "Cart Data",
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "description": "The unique identifier for the cart.",
            "example": "cart-001"
          },
          "userId": {
            "type": "integer",
            "description": "The unique identifier for the user owning the cart.",
            "format": "int32",
            "example": 1
