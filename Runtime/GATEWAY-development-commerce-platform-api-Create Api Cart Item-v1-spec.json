          "cartId": "cart_12345",
          "userId": 1,
          "items": [],
          "subtotal": 100,
          "currency": "USD",
          "updatedAt": "2023-10-12T10:00:00Z",
          "added": {
            "sku": "item_1",
            "qty": 2
