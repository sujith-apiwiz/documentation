          "unitPrice": {
            "type": "integer",
            "description": "Price per unit of the item.",
            "format": "int32",
            "example": 100
          },
          "lineTotal": {
            "type": "integer",
            "description": "Total price for the quantity of the item.",
            "format": "int32",
            "example": 100
          }
