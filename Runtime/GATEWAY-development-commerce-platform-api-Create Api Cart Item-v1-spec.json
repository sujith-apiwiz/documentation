        "description": "Details about the items in the cart and associated metadata."
      },
      "CartItem": {
        "title": "Cart Item",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The stock keeping unit of the item.",
            "example": "item-sku-001"
          },
          "name": {
            "type": "string",
            "description": "The name of the item.",
            "example": "Item Name 1"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the item in the cart.",
            "format": "int32",
            "example": 2
          },
          "unitPrice": {
            "type": "integer",
            "description": "The price of a single unit of the item.",
            "format": "int32",
            "example": 100
          },
          "lineTotal": {
            "type": "integer",
            "description": "The total price for the quantity of this item in the cart.",
            "format": "int32",
            "example": 200
          }
        },
        "description": "Details about an individual item in the cart."
      },
      "AddedItem": {
        "title": "Added Item",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The stock keeping unit of the added item.",
            "example": "item-sku-002"
          },
          "qty": {
            "type": "integer",
            "description": "The quantity of the added item.",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Details about an item added to the cart."
      }
