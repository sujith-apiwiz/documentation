          },
          "author": {
            "type": "string",
            "description": "The name or identifier of the individual who authored the review.",
            "example": "Kenji Watanabe"
          }
        },
        "description": "A schema representing the body of a request to post a review for a product, containing details such as the rating, title, comment, and author information.",
        "example": {
          "rating": 5,
          "title": "Worth every rupee",
          "comment": "Bought it as a gift and they loved it.",
          "author": "Kenji Watanabe"
        }
