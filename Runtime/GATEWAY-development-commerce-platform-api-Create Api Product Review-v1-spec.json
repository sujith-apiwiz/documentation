      "ProductReviewData": {
        "title": "Product Review Data Schema",
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "description": "Unique identifier for the review.",
            "example": "rev-78910"
          },
          "sku": {
            "type": "string",
            "description": "Stock Keeping Unit identifier for the product being reviewed.",
            "example": "sku-12345"
          },
          "rating": {
            "type": "integer",
            "description": "The rating given to the product by the reviewer (typically from 1 to 5).",
            "format": "int32",
            "example": 4
          },
          "title": {
            "type": "string",
            "description": "The title of the review.",
            "example": "Great Product"
          },
          "comment": {
            "type": "string",
            "description": "The actual text of the review comment.",
            "example": "This product worked really well for me."
          },
          "author": {
            "type": "string",
            "description": "The name of the person who wrote the review.",
            "example": "John Doe"
          },
          "verifiedPurchase": {
            "type": "boolean",
            "description": "Indicates whether the review is from a verified purchase.",
            "example": true
          },
          "helpfulVotes": {
            "type": "integer",
            "description": "The number of helpful votes the review has received.",
            "format": "int32",
            "example": 10
          },
          "createdAt": {
            "type": "string",
            "description": "The date and time when the review was created.",
            "example": "2023-10-01T12:00:00Z"
          },
          "status": {
            "type": "string",
            "description": "The current status of the review (e.g., published, pending, rejected).",
            "example": "published"
          }
        },
        "description": "Schema representing the detailed information of a product review."
