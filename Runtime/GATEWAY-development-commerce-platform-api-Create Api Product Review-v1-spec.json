            "example": "I loved this product!"
          },
          "author": {
            "type": "string",
            "description": "The name of the reviewer.",
            "example": "Jane Doe"
          },
          "verifiedPurchase": {
            "type": "boolean",
            "description": "Indicates whether the review is from a verified purchaser.",
            "example": true
          },
          "helpfulVotes": {
            "type": "integer",
            "description": "The number of users who found the review helpful.",
            "format": "int32",
            "example": 10
          },
          "createdAt": {
            "type": "string",
