        "type": "object",
        "properties": {
          "rating": {
            "type": "integer",
            "description": "The rating given by the author, typically on a scale from 0 to 5.",
            "format": "int32",
            "example": 5
          },
          "title": {
            "type": "string",
            "description": "The title of the review (a brief summary of the reviewer's opinion).",
            "example": "Worth every rupee"
          },
          "comment": {
            "type": "string",
