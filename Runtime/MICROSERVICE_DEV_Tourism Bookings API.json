      "MICROSERVICE_DEV_createBooking-CreateBookingRequest": {
        "title": "Booking Request",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "description": "A unique identifier for the booking.",
            "example": "TB-427377"
          },
          "touristId": {
            "type": "string",
            "description": "The identifier for the tourist making the booking.",
            "example": "TUR-34926"
          },
          "destination": {
            "type": "string",
            "description": "The destination for the booking.",
            "example": "Kyoto"
          },
          "packageName": {
            "type": "string",
            "description": "The name of the travel package selected by the tourist.",
            "example": "City Highlights"
          },
          "travelers": {
            "type": "integer",
            "description": "The number of travelers included in the booking.",
            "format": "int32",
            "example": 6
          },
          "startDate": {
            "type": "string",
            "description": "The start date of the booking, in ISO 8601 format.",
            "example": "2026-09-04T05:05:37.803Z"
          },
          "endDate": {
            "type": "string",
            "description": "The end date of the booking, in ISO 8601 format.",
            "example": "2026-06-28T07:19:53.377Z"
          },
          "totalAmount": {
            "type": "number",
            "description": "The total amount for the booking.",
            "example": 4868.74
          },
          "currency": {
            "type": "string",
            "description": "The currency in which the total amount is expressed.",
            "example": "GBP"
          }
        },
        "description": "A schema representing the request body for creating a new booking.",
        "example": {
