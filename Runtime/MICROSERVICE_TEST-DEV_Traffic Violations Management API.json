          "speedRecorded": {
            "type": "integer",
            "description": "The speed recorded at the time of violation, in kilometers per hour.",
            "format": "int32",
            "example": 118
          },
          "speedLimit": {
            "type": "integer",
            "description": "The speed limit in the area where the violation occurred, in kilometers per hour.",
            "format": "int32",
            "example": 60
          },
          "fineAmount": {
            "type": "integer",
            "description": "The amount of the fine imposed for the violation.",
            "format": "int32",
            "example": 541
          },
          "timestamp": {
            "type": "string",
            "description": "The date and time when the violation occurred.",
            "example": "2026-07-18T15:29:06.273Z"
          }
        },
        "description": "Schema representing a violation report submitted in the API request body.",
        "example": {
          "violationId": "VIO-623442",
          "vehicleNumber": "TN43CD5566",
          "violationType": "NO_HELMET",
          "location": {
            "lat": 10.318623,
            "lng": 90.476048,
            "area": "Airport Rd"
          },
          "speedRecorded": 118,
          "speedLimit": 60,
          "fineAmount": 541,
          "timestamp": "2026-07-18T15:29:06.273Z"
        }
      },
