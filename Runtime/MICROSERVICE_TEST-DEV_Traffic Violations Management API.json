      "MICROSERVICE_TEST-DEV_createViolationRecord-CreateViolationRecordRequest": {
        "title": "Violation Report",
        "type": "object",
        "properties": {
          "violationId": {
            "type": "string",
            "description": "Unique identifier for the violation.",
            "example": "VIO-623442"
          },
          "vehicleNumber": {
            "type": "string",
            "description": "License plate number of the vehicle involved in the violation.",
            "example": "TN43CD5566"
          },
          "violationType": {
            "type": "string",
            "description": "Type of violation (e.g., speeding, parking, etc.).",
            "example": "NO_HELMET"
