            "description": "Total cost of the order.",
            "format": "int32",
            "example": 200
          },
          "Currency": {
            "type": "string",
            "description": "Currency type for the order total.",
            "example": "USD"
          },
          "PlacedAt": {
            "type": "string",
            "description": "The date and time when the order was placed.",
            "example": "2021-01-01T10:00:00Z"
          }
        },
        "description": "Represents a single order with its details."
      },
      "OrderItem": {
        "title": "Order Item Object",
        "type": "object",
        "properties": {
