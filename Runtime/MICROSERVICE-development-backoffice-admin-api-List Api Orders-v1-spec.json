            "example": "sku123"
          },
          "Name": {
            "type": "string",
            "description": "Name of the item.",
            "example": "Item Name"
          },
          "Qty": {
            "type": "integer",
            "description": "Quantity of the item ordered.",
            "format": "int32",
            "example": 2
          },
          "UnitPrice": {
            "type": "integer",
            "description": "Price per unit of the item.",
            "format": "int32",
            "example": 100
          },
          "LineTotal": {
            "type": "integer",
            "description": "Total price for the line item (UnitPrice * Qty).",
            "format": "int32",
            "example": 200
          }
        },
        "description": "Represents a single item within an order."
      }
