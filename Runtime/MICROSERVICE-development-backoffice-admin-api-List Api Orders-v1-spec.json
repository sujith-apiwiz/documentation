      "Order": {
        "title": "Order Object",
        "type": "object",
        "properties": {
          "OrderId": {
            "type": "string",
            "description": "Unique identifier for the order.",
            "example": "order123"
          },
          "UserId": {
            "type": "integer",
            "description": "Identifier of the user who placed the order.",
            "format": "int32",
            "example": 1
          },
          "Status": {
            "type": "string",
            "description": "Current status of the order.",
            "example": "shipped"
          },
          "Items": {
            "type": "array",
            "description": "List of items included in the order.",
            "example": "[{\"Sku\": \"sku123\", \"Name\": \"Item Name\", \"Qty\": 2, \"UnitPrice\": 100, \"LineTotal\": 200}]",
