          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Request body for authorizing a payment. It should contain the necessary information such as payment method details, amount, and any additional parameters required for the authorization process.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentsPaymentsAuthorizeRequest"
              }
            }
          }
        },
        "responses": {
