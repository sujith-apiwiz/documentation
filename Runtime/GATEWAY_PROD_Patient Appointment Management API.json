        "title": "Appointment Error Response",
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "description": "The unique identifier for the insurance policy related to the appointment.",
            "example": "POL-100001"
          },
          "customerId": {
            "type": "string",
            "description": "The unique identifier for the customer who owns the insurance policy.",
            "example": "INS-10001"
          },
          "policyType": {
            "type": "string",
            "description": "The type of insurance policy associated with the appointment.",
            "example": "HEALTH"
          },
          "coverageAmount": {
            "type": "integer",
            "description": "The total amount covered by the insurance policy.",
            "format": "int32",
            "example": 500000
          },
          "premiumAmount": {
            "type": "integer",
            "description": "The amount paid periodically to maintain the insurance policy.",
            "format": "int32",
            "example": 12000
          },
          "status": {
            "type": "string",
            "description": "The current status of the policy.",
            "example": "ACTIVE"
          },
          "startDate": {
            "type": "string",
            "description": "The date when the insurance policy becomes effective.",
            "example": "2026-07-16"
          },
          "endDate": {
            "type": "string",
            "description": "The date when the insurance policy expires.",
            "example": "2027-07-16"
          },
          "message": {
            "type": "string",
            "description": "A message providing additional details about the error.",
            "example": "Insurance policy created successfully."
          }
        },
        "description": "Response schema for error encountered during appointment operations, indicating issues related to policies.",
