      "put": {
        "tags": [
          "Points Management"
        ],
        "summary": "Transfer points from one account to another.",
        "description": "This endpoint allows users to transfer points between accounts. Ensure that the source account has sufficient points before initiating the transfer. The request must include both the source and destination account details along with the amount of points to be transferred.",
        "operationId": "replaceHotelLoyaltyPointsTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "Transfer points between users. This operation allows a user to transfer a specific amount of points to another user by providing their identifiers and the desired transfer amount.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceHotelLoyaltyPointsTransferRequest"
              }
            }
          }
        },
        "responses": {
