            "type": "string",
            "description": "Type of room booked (e.g., single, double, suite).",
            "example": "SUITE"
          },
          "checkInDate": {
            "type": "string",
            "description": "Check-in date for the booking in ISO 8601 format.",
            "example": "2026-08-09T23:19:28.187Z"
          },
          "checkOutDate": {
            "type": "string",
            "description": "Check-out date for the booking in ISO 8601 format.",
            "example": "2026-08-15T14:10:14.569Z"
          },
          "guests": {
            "type": "integer",
            "description": "Total number of guests for the booking.",
            "format": "int32",
            "example": 4
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount for the booking.",
            "example": 1561.33
          },
          "currency": {
            "type": "string",
            "description": "Currency in which the total amount is expressed (e.g., USD, EUR).",
            "example": "EUR"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Current payment status of the booking (e.g., paid, pending, canceled).",
            "example": "REFUNDED"
          }
        },
