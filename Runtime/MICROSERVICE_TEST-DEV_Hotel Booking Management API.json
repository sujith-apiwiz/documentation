      "MICROSERVICE_TEST-DEV_createBooking-CreateBookingRequest": {
        "title": "Booking Request",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "description": "Unique identifier for the booking.",
            "example": "HB-835920"
          },
          "hotelId": {
            "type": "string",
            "description": "Identifier for the hotel where the booking is made.",
            "example": "HTL-6398"
          },
          "guestName": {
            "type": "string",
            "description": "Name of the guest making the booking.",
            "example": "Alex Nguyen"
          },
          "roomType": {
            "type": "string",
            "description": "Type of room booked (e.g., Single, Double, Suite).",
            "example": "DELUXE"
          },
          "checkInDate": {
            "type": "string",
            "description": "Check-in date in ISO 8601 format.",
            "example": "2026-08-04T07:35:27.005Z"
          },
          "checkOutDate": {
            "type": "string",
            "description": "Check-out date in ISO 8601 format.",
            "example": "2026-08-05T21:23:55.504Z"
          },
          "guests": {
            "type": "integer",
            "description": "Number of guests for the booking.",
            "format": "int32",
            "example": 3
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount for the booking.",
            "example": 1981.74
          },
          "currency": {
            "type": "string",
            "description": "Currency code for the total amount (e.g., USD, EUR).",
            "example": "USD"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Current payment status of the booking (e.g., Paid, Pending).",
            "example": "REFUNDED"
          }
        },
        "description": "Schema representing the request body for creating a new booking.",
        "example": {
          "bookingId": "HB-835920",
          "hotelId": "HTL-6398",
          "guestName": "Alex Nguyen",
          "roomType": "DELUXE",
          "checkInDate": "2026-08-04T07:35:27.005Z",
