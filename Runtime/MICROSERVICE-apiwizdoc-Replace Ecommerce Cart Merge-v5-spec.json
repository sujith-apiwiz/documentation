  "paths": {
    "/ecommerce/v5/cart/merge": {
      "put": {
        "tags": [
          "Shopping Cart"
        ],
        "summary": "Merge two shopping carts.",
        "description": "This endpoint allows users to merge items from one shopping cart into another. It is useful for combining purchases from multiple sessions or devices, ensuring that users don\u2019t lose items they intended to buy.",
        "operationId": "replaceEcommerceCartMerge",
        "parameters": [
          {
            "$ref": "#/components/parameters/validateOnly"
          },
          {
            "$ref": "#/components/parameters/x-client-version"
          },
          {
            "$ref": "#/components/parameters/x-request-priority"
          },
          {
            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to merge items into an existing cart. Ensure that the items you wish to merge are correctly formatted according to the schema provided.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceEcommerceCartMergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The cart merge operation completed successfully, updating the cart with the new items.",
            "headers": {
