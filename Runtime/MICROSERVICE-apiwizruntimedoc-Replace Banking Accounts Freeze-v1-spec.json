            "$ref": "#/components/parameters/x-mock-response"
          }
        ],
        "requestBody": {
          "description": "This request body is used to freeze an account temporarily. When an account is frozen, all transactions related to it will be halted until it is unfrozen. The payload should include the necessary identification details of the account that needs to be frozen.",
